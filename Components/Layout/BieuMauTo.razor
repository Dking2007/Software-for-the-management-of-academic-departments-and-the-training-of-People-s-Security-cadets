@using Nhom2_BTL.Models
@inject DialogService HoiThoai
@inject DichVuQuanLyDuLieuDemo DuLieu

@* Biểu mẫu tổ dùng bản nháp và dữ liệu chọn khoa từ kho mẫu. *@
<RadzenTemplateForm TItem="ToChuyenMon" Data="@banSao" Submit="Luu"><RadzenStack Gap="1rem">
<RadzenFormField Text="Mã tổ" Variant="Variant.Outlined"><RadzenTextBox Name="MaTo" @bind-Value="banSao.MaTo" Disabled="@DangSua" Style="width:100%" /></RadzenFormField>
<RadzenFormField Text="Tên tổ" Variant="Variant.Outlined"><RadzenTextBox Name="TenTo" @bind-Value="banSao.TenTo" Style="width:100%" /></RadzenFormField>
<RadzenFormField Text="Khoa trực thuộc" Variant="Variant.Outlined"><RadzenDropDown TValue="string" Name="MaKhoa" Data="@DanhSachKhoa" TextProperty="TenKhoa" ValueProperty="MaKhoa" @bind-Value="banSao.MaKhoa" Placeholder="Chọn khoa" Style="width:100%" /></RadzenFormField>
<TruongMoRongBieuMau @ref="moRong" Loai="ToChuyenMon" Ma="@(DangSua ? DuLieuBanDau.MaTo : null)" />
<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap=".75rem"><RadzenButton Text="Hủy" ButtonStyle="ButtonStyle.Light" Disabled="@dangLuu" Click="Huy" /><RadzenButton Disabled="@dangLuu" IsBusy="@dangLuu" BusyText="Đang lưu" Text="Lưu tổ" Icon="save" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" /></RadzenStack>
</RadzenStack>@if (!string.IsNullOrEmpty(loi)) { <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@loi</RadzenAlert> }
</RadzenTemplateForm>
@code {
    private TruongMoRongBieuMau? moRong;
[Parameter] public ToChuyenMon DuLieuBanDau { get; set; } = new();
[Parameter] public IReadOnlyList<Khoa> DanhSachKhoa { get; set; } = [];
[Parameter] public bool DangSua { get; set; }
private ToChuyenMon banSao = new();
protected override void OnInitialized() => banSao = DuLieuBanDau.TaoBanSao();
// Chặn bấm lặp; service là nơi xác thực quyền và các quan hệ trước khi ghi.
    private bool dangLuu;
    private string? loi;
    private async Task Luu(ToChuyenMon _)
    {
        if (dangLuu) return;
        dangLuu = true; loi = null;
        try
        {
            if (moRong?.KiemTra() is { } loiMoRong) { loi = loiMoRong; return; }
            var ketQua = await DuLieu.LuuToAsync(banSao, DangSua ? DuLieuBanDau.MaTo : null);
            if (ketQua.ThanhCong) { if (moRong is not null) await moRong.LuuAsync(ketQua.MaBanGhi ?? banSao.MaTo.Trim().ToUpperInvariant()); HoiThoai.Close(ketQua); }
            else loi = ketQua.ThongBao;
        }
        finally { dangLuu = false; }
    }
private void Huy() => HoiThoai.Close(null);
}

