@implements IDisposable
@inject NavigationManager DieuHuong
@inject NhaCungCapTrangThaiXacThucDemo XacThuc

@* Sidebar: thương hiệu, nhóm "Nghiệp vụ" (Khoa, Lớp, Học viên) và nhóm "Hệ thống" cho quản trị viên.
   Dùng liên kết và nút HTML thường thay cho RadzenPanelMenu để chữ, khoảng cách và trạng thái đang chọn đồng nhất. *@
<div class="sidebar-menu @(menuDangMo ? "menu-open" : string.Empty)">
    <div class="brand-block">
        <a class="brand-link" href="/" aria-label="Về trang chủ">
            <img class="brand-logo" src="images/logo-hoc-vien-an-ninh.png" alt="Logo Học viện An ninh nhân dân" />
            <span class="brand-copy"><strong>HỌC VIỆN AN NINH NHÂN DÂN</strong><small>Hệ thống quản lý đào tạo</small></span>
        </a>
    </div>
    <RadzenButton class="navbar-toggler" Icon="menu" ButtonStyle="ButtonStyle.Light" Click="@ToggleMenu" aria-label="Mở hoặc đóng menu điều hướng" />
    <nav class="nav-scrollable" aria-label="Điều hướng các phân hệ">

        <AuthorizeView>
            <Authorized>
                <span class="nhan-nhom-menu">Nghiệp vụ</span>
                <div class="module-groups">
                    <section class="module-menu-group @LopDangChon("khoa")">
                        <div class="module-menu-heading">
                            <a class="module-menu-main" href="/khoa" aria-label="Mở phân hệ Khoa"><RadzenIcon Icon="account_balance" /><span class="ten-phan-he">Khoa</span></a>
                            <button type="button" class="module-menu-toggle" @onclick="ToggleKhoa" aria-expanded="@(moKhoa ? "true" : "false")" aria-controls="muc-con-khoa" aria-label="@(moKhoa ? "Thu gọn mục Khoa" : "Mở các mục con của Khoa")"><RadzenIcon Icon="@(moKhoa ? "expand_less" : "expand_more")" /></button>
                        </div>
                        @if (moKhoa)
                        {
                            <ul class="menu-con" id="muc-con-khoa">
                                <li><NavLink class="muc-con" href="/khoa" Match="NavLinkMatch.All">Danh sách khoa</NavLink></li>
                                <li><NavLink class="muc-con" href="/khoa/to" Match="NavLinkMatch.All">Tổ chuyên môn</NavLink></li>
                                <li><NavLink class="muc-con" href="/khoa/can-bo" Match="NavLinkMatch.All">Cán bộ, giảng viên</NavLink></li>
                            </ul>
                        }
                    </section>
                    @* Lớp và Học viên chỉ có một trang nên là liên kết thẳng; chỉ Khoa cần menu con. *@
                    <section class="module-menu-group khong-con @LopDangChon("lop")">
                        <div class="module-menu-heading"><a class="module-menu-main" href="/lop" aria-label="Lớp đào tạo"><RadzenIcon Icon="groups" /><span class="ten-phan-he">Lớp đào tạo</span></a></div>
                    </section>
                    <section class="module-menu-group khong-con @LopDangChon("hoc-vien")">
                        <div class="module-menu-heading"><a class="module-menu-main" href="/hoc-vien" aria-label="Học viên"><RadzenIcon Icon="school" /><span class="ten-phan-he">Học viên</span></a></div>
                    </section>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="module-groups">
                    <section class="module-menu-group">
                        <div class="module-menu-heading"><a class="module-menu-main" href="/dang-nhap"><RadzenIcon Icon="login" /><span class="ten-phan-he">Đăng nhập</span></a></div>
                    </section>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
    <AuthorizeView Roles="Admin" Context="admin">
        <section class="module-menu-group khong-con menu-quan-tri @LopDangChon("quan-tri")">
            <span class="nhan-nhom-menu">Hệ thống</span>
            <div class="module-menu-heading"><a class="module-menu-main" href="/quan-tri/tai-khoan" aria-label="Quản trị hệ thống"><RadzenIcon Icon="manage_accounts" /><span class="ten-phan-he">Quản trị hệ thống</span></a></div>
        </section>
    </AuthorizeView>
</div>

@code {
    private bool menuDangMo;
    private bool moKhoa;
    private string phanHe = string.Empty;

    protected override void OnInitialized()
    {
        CapNhatPhanHe();
        DieuHuong.LocationChanged += KhiDoiTrang;
    }

    // Mở sẵn nhóm hiện tại để mục con dễ nhìn; nhóm khác vẫn có thể mở bằng mũi tên.
    private void CapNhatPhanHe()
    {
        var duongDan = DieuHuong.ToBaseRelativePath(DieuHuong.Uri).Split('?', '#')[0];
        phanHe = duongDan.StartsWith("khoa", StringComparison.OrdinalIgnoreCase) ? "khoa"
            : duongDan.StartsWith("lop", StringComparison.OrdinalIgnoreCase) ? "lop"
            : duongDan.StartsWith("hoc-vien", StringComparison.OrdinalIgnoreCase) ? "hoc-vien"
            : duongDan.StartsWith("quan-tri", StringComparison.OrdinalIgnoreCase) ? "quan-tri"
            : string.Empty;
        moKhoa = phanHe == "khoa";
    }

    private void KhiDoiTrang(object? sender, LocationChangedEventArgs args)
    {
        menuDangMo = false;
        CapNhatPhanHe();
        _ = InvokeAsync(StateHasChanged);
    }

    // Nhóm đang xem được tô nền (xem .dang-chon trong app.css); mục con đang xem nhận thêm class "active" từ NavLink.
    private string LopDangChon(string ma) => phanHe == ma ? "dang-chon" : string.Empty;

    private void ToggleKhoa() => moKhoa = !moKhoa;
    private void ToggleMenu() => menuDangMo = !menuDangMo;
    public void Dispose() { DieuHuong.LocationChanged -= KhiDoiTrang; }
}
