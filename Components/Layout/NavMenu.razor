@* Vai trò tệp: Menu theo vai trò, nhóm thông tin, nghiệp vụ và quản trị. *@
@inject TuyChonGiaoDien TuyChon
@implements IDisposable
@inject NavigationManager DieuHuong
@inject DichVuQuanLyDuLieuDemo DuLieu

<div class="sidebar-menu @(menuDangMo ? "menu-open" : string.Empty)">
    <div class="brand-block">
        <a class="brand-link" href="/" aria-label="@TuyChon.Dich("Về trang chủ")">
            <img class="brand-logo" src="images/logo-hoc-vien-an-ninh.png" alt="Logo Học viện An ninh nhân dân" />
            <span class="brand-copy"><strong>HỌC VIỆN AN NINH NHÂN DÂN</strong><small>Hệ thống quản lý Khoa/Lớp đào tạo</small></span>
        </a>
    </div>
    <RadzenButton class="navbar-toggler" Icon="menu" ButtonStyle="ButtonStyle.Light" Click="ToggleMenu" aria-label="@TuyChon.Dich("Mở hoặc đóng điều hướng")" />
    <nav class="nav-scrollable" aria-label="@TuyChon.Dich("Điều hướng các phân hệ")">
        <AuthorizeView>
            <Authorized>
                <span class="nhan-nhom-menu">@TuyChon.Dich("Thông tin")</span>
                <div class="module-groups" style="margin-bottom:.75rem">
                    <section class="module-menu-group @(phanHe == "ban-tin" ? "dang-chon" : "")" data-phan-he="ban-tin">
                        <div class="module-menu-heading"><NavLink class="module-menu-main" href="/ban-tin"><RadzenIcon Icon="newspaper" /><span class="ten-phan-he">@TuyChon.Dich("Bản tin Học viện")</span></NavLink></div>
                        <div class="menu-bay"><strong>@TuyChon.Dich("Bản tin Học viện")</strong><RadzenLink Path="/ban-tin" Text="Trang nhất" /><RadzenLink Path="/thong-bao" Text="Văn bản, thông báo" /></div>
                    </section>
                    <section class="module-menu-group @(phanHe == "so-do" ? "dang-chon" : "")" data-phan-he="so-do">
                        <div class="module-menu-heading"><NavLink class="module-menu-main" href="/khoa/so-do" Match="NavLinkMatch.All"><RadzenIcon Icon="account_tree" /><span class="ten-phan-he">@TuyChon.Dich("Sơ đồ tổ chức")</span></NavLink></div>
                    </section>
                </div>
                <span class="nhan-nhom-menu">@TuyChon.Dich("Nghiệp vụ")</span>
                <div class="module-groups">
                    @foreach (var nhom in cacNhom)
                    {
                        <section class="module-menu-group @(phanHe == nhom.Ma ? "dang-chon" : "")" data-phan-he="@nhom.Ma">
                            <div class="module-menu-heading">
                                <NavLink class="module-menu-main" href="@nhom.DuongDan" Match="NavLinkMatch.All"><RadzenIcon Icon="@nhom.BieuTuong" /><span class="ten-phan-he">@TuyChon.Dich(nhom.Ten)</span></NavLink>
                                <RadzenButton class="module-menu-toggle" Icon="@(nhomMo.Contains(nhom.Ma) ? "expand_less" : "expand_more")" ButtonStyle="ButtonStyle.Light" Click="@(() => DoiNhom(nhom.Ma))" aria-label="@($"Mở/đóng {nhom.Ten}")" aria-expanded="@(nhomMo.Contains(nhom.Ma) ? "true" : "false")" aria-controls="@($"menu-{nhom.Ma}")" />
                            </div>
                            @if (nhomMo.Contains(nhom.Ma))
                            {
                                <ul class="menu-con" id="@($"menu-{nhom.Ma}")">
                                    @foreach (var muc in nhom.CacMuc)
                                    {
                                        <li><NavLink class="muc-con" href="@muc.DuongDan" Match="@(muc.KhopTienTo ? NavLinkMatch.Prefix : NavLinkMatch.All)" title="@TuyChon.Dich(muc.Ten)">@TuyChon.Dich(muc.Ten)</NavLink></li>
                                    }
                                </ul>
                            }
                            <div class="menu-bay" aria-label="@nhom.Ten">
                                <strong>@TuyChon.Dich(nhom.Ten)</strong>
                                @foreach (var muc in nhom.CacMuc) { <RadzenLink Path="@muc.DuongDan" Text="@TuyChon.Dich(muc.Ten)" /> }
                            </div>
                        </section>
                    }
                </div>
            </Authorized>
            <NotAuthorized><RadzenLink Path="/dang-nhap" Text="@TuyChon.Dich("Đăng nhập")" Icon="login" /></NotAuthorized>
        </AuthorizeView>
    </nav>
    <AuthorizeView>
        <Authorized>
            <section class="module-menu-group menu-tro-giup">
                <span class="nhan-nhom-menu">@TuyChon.Dich("Hệ thống")</span>
                <NavLink class="module-menu-main" href="/tro-giup"><RadzenIcon Icon="help_outline" /><span class="ten-phan-he">@TuyChon.Dich("Trợ giúp")</span></NavLink>
            </section>
        </Authorized>
    </AuthorizeView>
    @if (cacMucQuanTri.Length > 0)
    {
        <section class="module-menu-group menu-quan-tri @(phanHe == "quan-tri" ? "dang-chon" : "")">
            <NavLink class="module-menu-main" href="@cacMucQuanTri[0].DuongDan"><RadzenIcon Icon="manage_accounts" /><span class="ten-phan-he">@TuyChon.Dich("Quản trị hệ thống")</span></NavLink>
            @if (phanHe == "quan-tri" && cacMucQuanTri.Length > 1)
            {
                <ul class="menu-con">@foreach (var muc in cacMucQuanTri) { <li><NavLink class="muc-con" href="@muc.DuongDan" Match="NavLinkMatch.All">@TuyChon.Dich(muc.Ten)</NavLink></li> }</ul>
            }
            <div class="menu-bay"><strong>@TuyChon.Dich("Quản trị hệ thống")</strong>@foreach (var muc in cacMucQuanTri) { <RadzenLink Path="@muc.DuongDan" Text="@TuyChon.Dich(muc.Ten)" /> }</div>
        </section>
    }
</div>

@* Xử lý phía thành phần: tham số, trạng thái và sự kiện phục vụ giao diện bên trên. *@
@code {
    private sealed record MucMenu(string Ten, string DuongDan, bool KhopTienTo = false);
    private sealed record NhomMenu(string Ma, string Ten, string BieuTuong, string DuongDan, MucMenu[] CacMuc);
    [CascadingParameter] private Task<AuthenticationState>? TrangThaiXacThuc { get; set; }
    private NhomMenu[] cacNhom = [];
    private MucMenu[] cacMucQuanTri = [];

    // Menu dựng theo vai trò để mỗi người chỉ thấy phần mình dùng. Đây chỉ là trải nghiệm;
    // quyền thật được kiểm ở dịch vụ, vào thẳng đường dẫn vẫn chỉ nhận mặt cắt dữ liệu được phép.
    protected override async Task OnParametersSetAsync()
    {
        var nd = TrangThaiXacThuc is null ? NguoiDungHienTai.Khach : NguoiDungHienTai.Tu((await TrangThaiXacThuc).User);
        var nhom = new List<NhomMenu>();
        if (nd.LaGiangVien) nhom.Add(new("ca-nhan", "Giảng dạy của tôi", "co_present", "/giang-day", [new("Lớp và buổi dạy", "/giang-day"), new("Lịch dạy", "/dao-tao/lich")]));
        if (nd.LaHocVien) nhom.Add(new("ca-nhan", "Học tập của tôi", "person", "/cua-toi", [new("Tổng quan cá nhân", "/cua-toi"), new("Lịch học", "/dao-tao/lich")]));
        // Mỗi manager thấy đủ mảng mình sở hữu; mảng khác chỉ hiện mục phối hợp (xem) cần cho công việc.
        MucMenu[] khoaDu = [new("Danh sách khoa", "/khoa"), new("Tổ chuyên môn", "/khoa/to"), new("Cán bộ, giảng viên", "/khoa/can-bo"), new("Điểm danh đi làm", "/khoa/cham-cong"), new("Trực ban", "/khoa/truc-ban")];
        MucMenu[] daoTaoDu = [new("Tổng quan đào tạo", "/dao-tao"), new("Chuyên ngành", "/dao-tao/chuyen-nganh"), new("Khóa và niên khóa", "/dao-tao/khoa-hoc"), new("Chuyên đề", "/dao-tao/chuyen-de"), new("Chương trình & phân công", "/dao-tao/chuong-trinh"), new("Lịch đào tạo", "/dao-tao/lich"), new("Tình hình lên lớp", "/dao-tao/lich/tinh-hinh"), new("Phòng học", "/dao-tao/phong"), new("Xét tư cách & lịch thi", "/dao-tao/thi")];
        if (nd.LaAdmin || nd.LaQuanLy("Khoa")) nhom.Add(new("khoa", "Quản lý khoa", "account_balance", "/khoa", khoaDu));
        else if (nd.LaQuanLy("DaoTao")) nhom.Add(new("khoa", "Khoa (phối hợp)", "account_balance", "/khoa", [new("Danh sách khoa", "/khoa"), new("Cán bộ, giảng viên", "/khoa/can-bo")]));
        else if (nd.LaQuanLy("Lop")) nhom.Add(new("khoa", "Khoa (phối hợp)", "account_balance", "/khoa", [new("Cán bộ, giảng viên", "/khoa/can-bo")]));
        else if (nd.LaGiangVien) nhom.Add(new("khoa", "Quản lý khoa", "account_balance", "/khoa", [.. khoaDu.Take(3), new("Trực ban", "/khoa/truc-ban")]));
        else if (nd.VaiTro == "Guest") nhom.Add(new("khoa", "Quản lý khoa", "account_balance", "/khoa", khoaDu.Take(3).ToArray()));
        if (nd.LaAdmin || nd.LaQuanLy("DaoTao") || nd.LaGiangVien) nhom.Add(new("dao-tao", "Quản lý đào tạo", "menu_book", "/dao-tao", daoTaoDu));
        else if (nd.LaQuanLy("Khoa")) nhom.Add(new("dao-tao", "Đào tạo (phối hợp)", "menu_book", "/dao-tao", [new("Chuyên đề (GV đủ điều kiện)", "/dao-tao/chuyen-de"), new("Lịch đào tạo", "/dao-tao/lich"), new("Xét tư cách thi (khoa xác nhận)", "/dao-tao/thi")]));
        else if (nd.LaQuanLy("Lop")) nhom.Add(new("dao-tao", "Đào tạo (phối hợp)", "menu_book", "/dao-tao", [new("Lịch đào tạo", "/dao-tao/lich"), new("Tình hình lên lớp", "/dao-tao/lich/tinh-hinh"), new("Chương trình (xem)", "/dao-tao/chuong-trinh"), new("Xét tư cách thi (đề xuất)", "/dao-tao/thi")]));
        else if (nd.VaiTro == "Guest") nhom.Add(new("dao-tao", "Quản lý đào tạo", "menu_book", "/dao-tao", daoTaoDu.Take(4).ToArray()));
        // Quản lý khoa không xem danh sách lớp/học viên; Quản lý đào tạo chỉ thấy lớp ở mức tổng hợp (hàng rào 2).
        if (nd.LaQuanLy("Khoa")) { }
        else if (nd.LaQuanLy("DaoTao")) nhom.Add(new("hoc-vien", "Lớp (tổng hợp)", "school", "/quan-ly-hoc-vien", [new("Tổng quan các hệ", "/quan-ly-hoc-vien/lop"), .. CacMucHe()]));
        else if (nd.LaGiangVien) nhom.Add(new("hoc-vien", "Lớp tôi dạy", "school", "/quan-ly-hoc-vien", [new("Danh sách lớp", "/quan-ly-hoc-vien/lop"), new("Học viên các lớp", "/quan-ly-hoc-vien/hoc-vien")]));
        else if (nd.LaHocVien) nhom.Add(new("hoc-vien", "Lớp của tôi", "school", "/quan-ly-hoc-vien", [new("Thông tin lớp", "/quan-ly-hoc-vien/lop")]));
        else nhom.Add(new("hoc-vien", "Quản lý học viên", "school", "/quan-ly-hoc-vien", [new("Tổng quan các hệ", "/quan-ly-hoc-vien/lop"), .. CacMucHe(), new("Danh sách học viên", "/quan-ly-hoc-vien/hoc-vien")]));
        cacNhom = nhom.ToArray();
        var quanTri = new List<MucMenu>();
        if (nd.LaAdmin || nd.LaQuanLy("DaoTao") || nd.LaQuanLy("Lop")) quanTri.Add(new("Tài khoản và phân quyền", "/quan-tri/tai-khoan"));
        if (nd.LaAdmin || nd.VaiTro == "Manager") quanTri.Add(new("Trường dữ liệu mở rộng", "/quan-tri/truong-du-lieu"));
        if (nd.LaAdmin) quanTri.Add(new("Nhật ký thao tác", "/quan-tri/nhat-ky"));
        cacMucQuanTri = quanTri.ToArray();
        CapNhat();
    }
    // Mỗi hệ đào tạo có dữ liệu là một mục riêng; vào trong là khoá, rồi tới lớp.
    private MucMenu[] CacMucHe() => DuLieu.LayDanhSachLop().Select(l => l.HeDaoTao).Distinct()
        .OrderBy(h => Array.IndexOf(QuyTacDuLieu.CacHeDaoTao, h))
        .Select(h => new MucMenu("Hệ " + h.ToLowerInvariant(), "/quan-ly-hoc-vien/he/" + QuyTacDuLieu.MaHe(h), true)).ToArray();
    private bool menuDangMo;
    private string phanHe = "";
    private readonly HashSet<string> nhomMo = [];
    // Khởi tạo trạng thái khi thành phần được tạo.
    protected override void OnInitialized() { TuyChon.DaThayDoi += KhiDoiTuyChon; CapNhat(); DieuHuong.LocationChanged += KhiDoiTrang; }
    private void CapNhat()
    {
        var duongDan = DieuHuong.ToBaseRelativePath(DieuHuong.Uri).Split('?', '#')[0];
        phanHe = duongDan.TrimEnd('/') == "khoa/so-do" ? "so-do" : duongDan.Split('/')[0] switch { "khoa" => "khoa", "dao-tao" => "dao-tao", "lop" or "hoc-vien" or "quan-ly-hoc-vien" => "hoc-vien", "quan-tri" => "quan-tri", "giang-day" or "cua-toi" => "ca-nhan", "ban-tin" => "ban-tin", _ => "" };
        nhomMo.Clear();
        if (phanHe != "") nhomMo.Add(phanHe);
    }
    // Cập nhật điều hướng khi địa chỉ trang thay đổi.
    private void KhiDoiTrang(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(() => { menuDangMo = false; CapNhat(); StateHasChanged(); });
    private void DoiNhom(string ma) { if (!nhomMo.Remove(ma)) nhomMo.Add(ma); }
    private void ToggleMenu() => menuDangMo = !menuDangMo;
    // Cập nhật hiển thị khi tùy chọn giao diện thay đổi.
    private void KhiDoiTuyChon() => _ = InvokeAsync(StateHasChanged);
    // Giải phóng tài nguyên và các đăng ký theo dõi khi kết thúc sử dụng.
    public void Dispose() { DieuHuong.LocationChanged -= KhiDoiTrang; TuyChon.DaThayDoi -= KhiDoiTuyChon; }
}
