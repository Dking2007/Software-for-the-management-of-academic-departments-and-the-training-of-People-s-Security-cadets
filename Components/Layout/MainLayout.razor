@* Vai trò tệp: Khung sau đăng nhập: điều hướng, thanh công cụ và nội dung trang. *@
@implements IDisposable
@inject TuyChonGiaoDien TuyChon
@inherits LayoutComponentBase

@* Bố cục chính chứa thanh điều hướng, thông tin tài khoản và nội dung trang đã đăng nhập. *@
<div class="app-shell @(sidebarThuGon ? "sidebar-thu-gon" : string.Empty)">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <div class="main-area">
        <header class="top-row">
            <div class="top-row-trai">
                <RadzenButton class="nut-sidebar" Icon="@(sidebarThuGon ? "menu" : "menu_open")" ButtonStyle="ButtonStyle.Light" Click="@DoiTrangThaiSidebar" aria-label="@(sidebarThuGon ? "Mở rộng thanh điều hướng" : "Thu gọn thanh điều hướng")" aria-expanded="@(!sidebarThuGon ? "true" : "false")" />
                @* Đường dẫn dựng từ địa chỉ hiện tại; mục cuối là trang đang xem nên không có liên kết. *@
                <nav class="duong-dan" aria-label="@TuyChon.Dich("Vị trí hiện tại")">
                    <RadzenBreadCrumb>
                        @foreach (var muc in LayDuongDan())
                        {
                            <RadzenBreadCrumbItem Path="@muc.DuongDan" Text="@TuyChon.Dich(muc.Ten)" Icon="@muc.BieuTuong" />
                        }
                    </RadzenBreadCrumb>
                </nav>
            </div>
            @* Tên và vai trò lấy từ claim của phiên hiện tại. Form đăng xuất giữ nguyên cơ chế token, chỉ đổi chỗ hiển thị vào menu thả xuống. *@
            <AuthorizeView>
                <Authorized Context="nguoiDung">
                    <div class="cong-cu-tai-khoan">
                        <TimKiemNhanh />
                        @* Thông tin để hướng dẫn nhập môn chọn đúng nội dung; chỉ là tên và vai trò đang hiển thị trên trang. *@
                        <span hidden data-huong-dan-nguoi="@nguoiDung.User.Identity?.Name" data-huong-dan-vai-tro="@MaVaiTroHuongDan(nguoiDung.User)"></span>
                        <button type="button" class="nut-huong-dan" data-mo-huong-dan title="@TuyChon.Dich("Hướng dẫn nhanh")" aria-label="@TuyChon.Dich("Hướng dẫn nhanh")"><RadzenIcon Icon="flag" /></button>
                        <ChuongThongBao />
                        <CaiDatGiaoDien />
                        <div class="menu-nguoi-dung" @onkeydown="PhimTrongMenu">
                            <button type="button" class="nut-nguoi-dung" @onclick="DoiMenuNguoiDung" aria-haspopup="true" aria-expanded="@(menuNguoiDungMo ? "true" : "false")">
                                <span class="user-avatar">@LayInitial(nguoiDung.User.Identity?.Name)</span>
                                <span class="user-details">
                                    <span class="user-name">@nguoiDung.User.Identity?.Name</span>
                                    <span class="user-role">@LayTenVaiTro(nguoiDung.User)</span>
                                </span>
                                <RadzenIcon Icon="@(menuNguoiDungMo ? "expand_less" : "expand_more")" />
                            </button>
                            @if (menuNguoiDungMo)
                            {
                                @* Lớp phủ trong suốt: bấm ra ngoài thì đóng menu. *@
                                <div class="phu-menu-nguoi-dung" @onclick="DongMenuNguoiDung"></div>
                                <div class="hop-nguoi-dung" role="menu">
                                    <div class="hop-nguoi-dung-ten">
                                        <strong>@nguoiDung.User.Identity?.Name</strong>
                                        <span>@LayTenVaiTro(nguoiDung.User)</span>
                                    </div>
                                    <a class="lien-ket-ho-so" href="/ho-so" @onclick="DongMenuNguoiDung"><RadzenIcon Icon="badge" />Hồ sơ cá nhân</a>
                                    <form data-bieu-mau-phien method="post" action="/phien/dang-xuat" data-enhance="false"><AntiforgeryToken /><RadzenButton class="nut-dang-xuat" Icon="logout" Text="@TuyChon.Dich("Đăng xuất")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" ButtonType="ButtonType.Submit" /></form>
                                </div>
                            }
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        <main class="content">
            <CascadingValue Name="NgonNguGiaoDien" Value="@TuyChon.NgonNgu">@Body</CascadingValue>
            @* Trang chủ đã có nhãn dữ liệu mẫu ở đầu trang nên chân trang chỉ hiện ở các màn hình quản lý. *@
            @if (!LaTrangChu)
            {
                <footer class="app-footer">Bản demo học tập · dữ liệu và tài khoản giả lập, không dùng cho hệ thống thật</footer>
            }
        </main>
    </div>
</div>

@* Nút về đầu trang: wwwroot/hieu-ung.js bật lớp "hien" khi đã cuộn xuống 320 px. *@
<button type="button" id="nut-len-dau" class="nut-len-dau" title="@TuyChon.Dich("Về đầu trang")" aria-label="@TuyChon.Dich("Về đầu trang")"><RadzenIcon Icon="keyboard_arrow_up" /></button>

<div id="blazor-error-ui">
    @* Giữ bộ chọn CSS của Blazor nhưng dùng Radzen cho điều khiển trong thông báo lỗi. *@
    @* Nằm trên mọi hộp thoại (xem giao-dien-toi.css). Dùng thẻ a thường + location.reload vì lúc này kết nối Blazor đã ngắt. *@
    <span><strong>Trang mất kết nối do một lỗi.</strong> Các thay đổi đã bấm lưu thành công vẫn được giữ.</span>
    <a href="" class="reload" onclick="location.reload(); return false;">Tải lại trang</a>
    <RadzenButton class="dismiss" Text="@TuyChon.Dich("×")" ButtonStyle="ButtonStyle.Light" aria-label="@TuyChon.Dich("Đóng thông báo lỗi")" />
</div>

@* Đăng ký các thành phần Radzen cần dịch vụ tương tác như hộp thoại và thông báo. *@
<RadzenComponents />

@* Xử lý phía thành phần: tham số, trạng thái và sự kiện phục vụ giao diện bên trên. *@
@code {
    // Khởi tạo trạng thái khi thành phần được tạo.
    protected override void OnInitialized() => TuyChon.DaThayDoi += KhiDoiTuyChon;
    // Cập nhật hiển thị khi tùy chọn giao diện thay đổi.
    private void KhiDoiTuyChon() => _ = InvokeAsync(StateHasChanged);
    // Giải phóng tài nguyên và các đăng ký theo dõi khi kết thúc sử dụng.
    public void Dispose() { TuyChon.DaThayDoi -= KhiDoiTuyChon; cauNoiHuongDan?.Dispose(); }

    // Hướng dẫn nhập môn nhớ theo tài khoản ở máy chủ: gửi danh sách đã xem cho huong-dan.js,
    // và cho JS gọi ngược DanhDauHuongDan khi người dùng xem/bỏ qua. Tên tài khoản lấy từ phiên, không từ trình duyệt.
    [Inject] private DichVuHuongDan HuongDan { get; set; } = default!;
    private DotNetObjectReference<MainLayout>? cauNoiHuongDan;
    [JSInvokable] public Task DanhDauHuongDan(string khoa) => HuongDan.DanhDauAsync(khoa);
    private async Task KetNoiHuongDanAsync()
    {
        var daXem = await HuongDan.LayDaXemAsync();
        cauNoiHuongDan ??= DotNetObjectReference.Create(this);
        await JavaScript.InvokeVoidAsync("huongDan.ketNoi", cauNoiHuongDan, daXem.ToArray());
    }

    [Inject] private NavigationManager DieuHuong { get; set; } = default!;

    [Inject] private IJSRuntime JavaScript { get; set; } = default!;

    private bool sidebarThuGon;
    private async Task DoiTrangThaiSidebar()
    {
        sidebarThuGon = !sidebarThuGon;
        try { await JavaScript.InvokeVoidAsync("thuGonMenu.luu", sidebarThuGon); } catch (JSException) { } catch (InvalidOperationException) { }
    }

    // Đọc lựa chọn đã lưu sau lần hiển thị đầu (JS interop chỉ dùng được khi trang đã dựng xong ở trình duyệt).
    protected override async Task OnAfterRenderAsync(bool lanDau)
    {
        if (!lanDau) return;
        try
        {
            var thuGon = await JavaScript.InvokeAsync<bool>("thuGonMenu.doc");
            if (thuGon != sidebarThuGon) { sidebarThuGon = thuGon; StateHasChanged(); }
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        try { await KetNoiHuongDanAsync(); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        catch (Microsoft.Data.Sqlite.SqliteException) { /* thiếu bảng/khóa CSDL: bỏ qua hướng dẫn, không làm hỏng trang */ }
    }

    private bool menuNguoiDungMo;
    private void DoiMenuNguoiDung() => menuNguoiDungMo = !menuNguoiDungMo;
    private void DongMenuNguoiDung() => menuNguoiDungMo = false;
    private void PhimTrongMenu(KeyboardEventArgs e) { if (e.Key == "Escape") menuNguoiDungMo = false; }

    private string? KhoaTrenDuongDan()
    {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(DieuHuong.Uri).Query);
        return q.TryGetValue("khoa", out var v) && !string.IsNullOrWhiteSpace(v) ? v.ToString() : null;
    }
    private string DuongDanHienTai => DieuHuong.ToBaseRelativePath(DieuHuong.Uri).Split('?', '#')[0].Trim('/');
    private bool LaTrangChu => string.IsNullOrEmpty(DuongDanHienTai);

    private sealed record MucDuongDan(string Ten, string? DuongDan = null, string? BieuTuong = null);

    // Mỗi trang đã biết có một chuỗi mục; địa chỉ lạ (lỗi, không tồn tại) chỉ hiện "Trang chủ".
    // Mục cuối luôn không có liên kết vì là trang đang xem.
    private IEnumerable<MucDuongDan> LayDuongDan()
    {
        var chuoi = DuongDanHienTai.ToLowerInvariant() switch
        {
            "khoa" => new[] { new MucDuongDan("Quản lý khoa", "/khoa") },
            "khoa/to" => new[] { new MucDuongDan("Quản lý khoa", "/khoa"), new MucDuongDan("Tổ chuyên môn") },
            "khoa/can-bo" => new[] { new MucDuongDan("Quản lý khoa", "/khoa"), new MucDuongDan("Cán bộ, giảng viên") },
            "khoa/so-do" => new[] { new MucDuongDan("Sơ đồ tổ chức") },
            "khoa/cham-cong" => new[] { new MucDuongDan("Quản lý khoa", "/khoa"), new MucDuongDan("Điểm danh đi làm") },
            "khoa/truc-ban" => new[] { new MucDuongDan("Quản lý khoa", "/khoa"), new MucDuongDan("Trực ban") },
            "ho-so" => new[] { new MucDuongDan("Hồ sơ cá nhân") },
            "ban-tin" => new[] { new MucDuongDan("Bản tin Học viện") },
            "tro-giup" => new[] { new MucDuongDan("Trợ giúp") },
            "thong-bao" => new[] { new MucDuongDan("Văn bản, thông báo") },
            "lop" => new[] { new MucDuongDan("Lớp đào tạo", "/lop") },
            "hoc-vien" => new[] { new MucDuongDan("Học viên", "/hoc-vien") },
            "quan-tri/tai-khoan" => new[] { new MucDuongDan("Quản trị hệ thống"), new MucDuongDan("Tài khoản và phân quyền") },
            "quan-tri/nhat-ky" => new[] { new MucDuongDan("Quản trị hệ thống"), new MucDuongDan("Nhật ký thao tác") },
            "giang-day" => new[] { new MucDuongDan("Giảng dạy của tôi") },
            "cua-toi" => new[] { new MucDuongDan("Học tập của tôi") },
            _ => Array.Empty<MucDuongDan>()
        };

        var cacDoan = DuongDanHienTai.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (cacDoan.FirstOrDefault() == "quan-ly-hoc-vien" || DuongDanHienTai is "lop" or "hoc-vien")
        {
            // Đi từ ngoài vào trong: Quản lý học viên → Hệ → Khoá → Lớp.
            MucDuongDan goc = new("Quản lý học viên", "/quan-ly-hoc-vien/lop");
            if (DuongDanHienTai == "hoc-vien" || DuongDanHienTai.EndsWith("/hoc-vien")) chuoi = [goc, new("Danh sách học viên")];
            else if (cacDoan.Length == 3 && cacDoan[1] == "he" && QuyTacDuLieu.HeTuMa(cacDoan[2]) is { } he)
                chuoi = KhoaTrenDuongDan() is { } kh ? [goc, new("Hệ " + he.ToLowerInvariant(), "/quan-ly-hoc-vien/he/" + cacDoan[2]), new("Khoá " + kh)] : [goc, new("Hệ " + he.ToLowerInvariant())];
            else if (cacDoan.Length == 3 && cacDoan[1] == "lop")
            {
                var ma = Uri.UnescapeDataString(cacDoan[2]);
                var heLop = QuyTacDuLieu.HeTuMaLop(ma);
                chuoi = heLop == "" ? [goc, new(ma)]
                    : [goc, new("Hệ " + heLop.ToLowerInvariant(), "/quan-ly-hoc-vien/he/" + QuyTacDuLieu.MaHe(heLop)), new("Khoá " + LichMaTranLop.KhoaCuaLop(ma), $"/quan-ly-hoc-vien/he/{QuyTacDuLieu.MaHe(heLop)}?khoa={LichMaTranLop.KhoaCuaLop(ma)}"), new(ma)];
            }
            else chuoi = [goc, new("Tổng quan các hệ")];
        }
        else if (cacDoan.FirstOrDefault() == "dao-tao" && cacDoan.Length == 3 && cacDoan[1] == "lich" && cacDoan[2] == "tinh-hinh")
            chuoi = [new("Quản lý đào tạo", "/dao-tao"), new("Lịch đào tạo", "/dao-tao/lich"), new("Tình hình lên lớp")];
        else if (cacDoan.FirstOrDefault() == "dao-tao")
            chuoi = cacDoan.Length == 1 ? [new("Quản lý đào tạo")] : [new("Quản lý đào tạo", "/dao-tao"), new(cacDoan[1] switch { "chuyen-nganh" => "Chuyên ngành", "chuyen-de" => "Chuyên đề", "lich" => "Lịch đào tạo", "phong" => "Phòng học", "chuong-trinh" => "Chương trình & phân công", "thi" => "Xét tư cách & lịch thi", _ => "Khóa và niên khóa" })];
        else if (cacDoan.FirstOrDefault() == "ban-tin" && cacDoan.Length == 2)
            chuoi = [new("Bản tin Học viện", "/ban-tin"), new("Bài viết")];
        else if (cacDoan.FirstOrDefault() == "khoa" && cacDoan.Length >= 3)
        {
            chuoi = [new("Quản lý khoa", "/khoa"), new(Uri.UnescapeDataString(cacDoan[1]), $"/khoa/{cacDoan[1]}/to"), new("Tổ chuyên môn")];
            if (cacDoan.Length == 4) chuoi = [new("Quản lý khoa", "/khoa"), new(Uri.UnescapeDataString(cacDoan[1]), $"/khoa/{cacDoan[1]}/to"), new(Uri.UnescapeDataString(cacDoan[3]))];
        }

        // Gốc là Trang chủ; nếu là trang đang xem thì bỏ liên kết. Trang chỉ có một mục thì mục đó cũng là trang đang xem.
        yield return new MucDuongDan("Trang chủ", chuoi.Length == 0 ? null : "/", "home");
        for (var i = 0; i < chuoi.Length; i++)
            yield return i == chuoi.Length - 1 ? chuoi[i] with { DuongDan = null } : chuoi[i];
    }

    // Đổi tên vai trò kỹ thuật trong claim thành nhãn tiếng Việt dễ đọc. Chỉ đổi nhãn hiển thị, claim giữ nguyên.
    private static string LayTenVaiTro(System.Security.Claims.ClaimsPrincipal nguoiDung)
        => NguoiDungHienTai.Tu(nguoiDung).TenVaiTro;

    private static string MaVaiTroHuongDan(System.Security.Claims.ClaimsPrincipal nguoiDung)
    {
        var nd = NguoiDungHienTai.Tu(nguoiDung);
        return nd.VaiTro == "Manager" ? nd.VaiTro + nd.PhamVi : nd.VaiTro;
    }

    // Lấy ký tự đầu làm chữ viết tắt; dùng dấu hỏi nếu tên chưa có giá trị.
    private static string LayInitial(string? ten)
        => string.IsNullOrWhiteSpace(ten) ? "?" : ten.Trim()[0].ToString().ToUpperInvariant();
}
