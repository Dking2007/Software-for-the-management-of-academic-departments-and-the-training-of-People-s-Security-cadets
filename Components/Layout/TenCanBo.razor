@* Vai trò tệp: Tên cán bộ kèm thao tác mở hồ sơ. *@
@inject DichVuQuanLyDuLieuDemo DuLieu

@* Tên cán bộ (lãnh đạo khoa/tổ): rê chuột hoặc focus để xem hồ sơ trong thẻ nổi (TheXemNhanh). *@
@if (string.IsNullOrWhiteSpace(MaCanBo))
{
    <span class="text-muted">Chưa phân công</span>
}
else
{
    <TheXemNhanh Loai="CanBo" Ma="@MaCanBo" Class="ten-can-bo">@DuLieu.LayTenCanBo(MaCanBo)</TheXemNhanh>
}

@* Xử lý phía thành phần: tham số, trạng thái và sự kiện phục vụ giao diện bên trên. *@
@code {
    [Parameter] public string? MaCanBo { get; set; }
}
