@* Chọn lớp theo cấp, đi từ ngoài vào trong và không trộn lẫn các hệ: Hệ đào tạo → Khoá (kèm niên khoá) → Lớp.
   Mỗi cấp là một hàng nút kèm số lượng; cấp sau chỉ hiện giá trị nằm trong cấp trước đã chọn. *@
<div class="bo-chon-cap">
    <div class="hang-cap">
        <span class="nhan-cap"><RadzenIcon Icon="school" />Hệ</span>
        <button type="button" class="@(He is null ? "dang-chon" : "")" @onclick="() => Chon(null, null, null)">Tất cả <small>@CacLop.Count</small></button>
        @foreach (var he in CacLop.GroupBy(l => l.HeDaoTao).OrderBy(g => Array.IndexOf(QuyTacDuLieu.CacHeDaoTao, g.Key)))
        {
            <button type="button" class="@(He == he.Key ? "dang-chon" : "")" @onclick="() => Chon(He == he.Key ? null : he.Key, null, null)">@he.Key <small>@he.Count() lớp</small></button>
        }
    </div>
    @if (He is not null)
    {
        var theoHe = CacLop.Where(l => l.HeDaoTao == He).ToList();
        <div class="hang-cap">
            <span class="nhan-cap"><RadzenIcon Icon="groups_3" />Khoá</span>
            @foreach (var kh in theoHe.GroupBy(l => l.KhoaHoc).OrderByDescending(g => g.First().NienKhoa))
            {
                <button type="button" class="@(Khoa == kh.Key ? "dang-chon" : "")" @onclick="() => Chon(He, Khoa == kh.Key ? null : kh.Key, null)" title="Niên khoá @kh.First().NienKhoa">@kh.Key <small>@kh.First().NienKhoa · @kh.Count() lớp</small></button>
            }
        </div>
        @if (Khoa is not null && HienLop)
        {
            <div class="hang-cap">
                <span class="nhan-cap"><RadzenIcon Icon="meeting_room" />Lớp</span>
                @foreach (var l in theoHe.Where(l => l.KhoaHoc == Khoa).OrderBy(l => l.MaLop.Length).ThenBy(l => l.MaLop))
                {
                    <button type="button" class="@(Lop == l.MaLop ? "dang-chon" : "")" @onclick="() => Chon(He, Khoa, Lop == l.MaLop ? null : l.MaLop)" title="@l.ChuyenNganh">@l.MaLop <small>@l.SiSo</small></button>
                }
            </div>
        }
    }
    @if (He is not null)
    {
        <div class="duong-cap"><RadzenIcon Icon="filter_alt" />Đang xem: <strong>Hệ @He.ToLowerInvariant()</strong>@if (Khoa is not null) { <span>›</span><strong>Khoá @Khoa</strong> }@if (Lop is not null) { <span>›</span><strong>Lớp @Lop</strong> }
            <button type="button" @onclick="() => Chon(null, null, null)">Bỏ chọn</button></div>
    }
</div>

@code {
    /// <summary>Bộ lọc theo cấp. Nam giữ lại cho tương thích, luôn null (niên khoá đã đi kèm khoá).</summary>
    public sealed record BoLoc(int? Nam, string? He, string? Khoa, string? Lop)
    {
        public bool Khop(LopDaoTao l) => (Nam is null || NamNhapHoc(l) == Nam) && (He is null || l.HeDaoTao == He) && (Khoa is null || l.KhoaHoc == Khoa) && (Lop is null || l.MaLop == Lop);
    }
    [Parameter, EditorRequired] public IReadOnlyList<LopDaoTao> CacLop { get; set; } = [];
    [Parameter] public bool HienLop { get; set; } = true;
    [Parameter] public EventCallback<BoLoc> KhiDoi { get; set; }
    private string? He, Khoa, Lop;
    public static int NamNhapHoc(LopDaoTao l) => int.TryParse(l.NienKhoa.Split('–')[0], out var n) ? n : 0;
    private async Task Chon(string? he, string? khoa, string? lop)
    {
        He = he; Khoa = khoa; Lop = lop;
        await KhiDoi.InvokeAsync(new BoLoc(null, He, Khoa, Lop));
    }
}
