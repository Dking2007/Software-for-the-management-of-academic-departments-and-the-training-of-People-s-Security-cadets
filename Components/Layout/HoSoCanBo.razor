@implements IDisposable
@inject DichVuQuanLyDuLieuDemo DuLieu
@inject KhoDuLieuDemo Kho

@if (canBo is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">Hồ sơ không còn tồn tại. Vui lòng đóng và tải lại danh sách.</RadzenAlert>
}
else
{
    <ChiTietHoSo CacTruong="@CacTruong" DoiTuong="Cán bộ" />
    <ThongTinMoRong Loai="CanBo" Ma="@MaCanBo" Class="nhom-ho-so" />
    @* Lịch sử bổ nhiệm thuộc nhóm "công tác": chỉ hiện khi mặt cắt có đủ dữ liệu (Admin, Quản lý khoa, chính cán bộ). *@
    @if (canBo.MaCanBo != "" && Kho.LayBoNhiem(MaCanBo) is { Count: > 0 } boNhiem)
    {
        <section class="nhom-ho-so">
            <h3><RadzenIcon Icon="workspace_premium" />Lịch sử bổ nhiệm</h3>
            <ul class="danh-sach-gon">@foreach (var b in boNhiem) { <li><span><strong>@b.ChucVu · @(b.LoaiDonVi == "Khoa" ? DuLieu.LayTenKhoa(b.MaDonVi) : DuLieu.LayTenTo(b.MaDonVi) + " (" + b.MaDonVi + ")")</strong><span>Từ @b.TuNgay.ToString("dd/MM/yyyy")@(b.DenNgay is { } den ? " đến " + den.ToString("dd/MM/yyyy") : "")</span></span><span class="nhan-trang-thai @(b.ConHieuLuc ? "hoat-dong" : "tam-dung")">@(b.ConHieuLuc ? "Đương nhiệm" : "Đã thôi")</span></li> }</ul>
        </section>
    }
}

@code {
    [Parameter] public string MaCanBo { get; set; } = "";
    private Nhom2_BTL.Models.CanBoGiangVien? canBo;

    // Cùng mã, cùng nguồn hồ sơ với bảng cán bộ; không dựng hồ sơ lãnh đạo riêng.
    protected override void OnInitialized() => DuLieu.DuLieuDaThayDoi += KhiDuLieuDoi;
    protected override void OnParametersSet() => TaiHoSo();
    private void TaiHoSo() => canBo = DuLieu.LayDanhSachCanBo().FirstOrDefault(x => x.MaTraCuuNoiBo == MaCanBo);
    private void KhiDuLieuDoi() => _ = InvokeAsync(() => { TaiHoSo(); StateHasChanged(); });
    public void Dispose() => DuLieu.DuLieuDaThayDoi -= KhiDuLieuDoi;

    private Dictionary<string, string?> CacTruong => new()
    {
        ["Mã cán bộ"] = canBo!.MaCanBo, ["Họ tên"] = canBo.HoTen,
        ["Giới tính"] = canBo.GioiTinh, ["Ngày sinh"] = canBo.NgaySinh.ToString("dd/MM/yyyy"),
        ["Chức vụ"] = canBo.ChucVu, ["Cấp bậc hàm"] = canBo.CapBacHam,
        ["Học hàm"] = canBo.HocHam, ["Học vị"] = canBo.HocVi,
        ["Chuyên môn"] = canBo.ChuyenMon, ["Quê quán"] = canBo.QueQuan,
        ["Số CCCD"] = canBo.SoCCCD, ["Số điện thoại"] = canBo.SoDienThoai,
        ["Email"] = canBo.Email, ["Khoa"] = canBo.TenKhoa, ["Tổ"] = canBo.TenTo
    };
}


