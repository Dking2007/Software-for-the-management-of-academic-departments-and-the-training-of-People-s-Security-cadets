@* Thanh công cụ của trang danh sách: ô tìm kiếm, bộ lọc tùy chọn và dòng đếm số bản ghi (nằm bên phải thanh).
   Trang cha giữ từ khóa và logic lọc; component này chỉ hiển thị và báo lại khi người dùng nhập.
   Thuộc tính data-tim-kiem để wwwroot/tim-kiem.js chờ 300 ms sau khi ngừng gõ rồi mới gửi sự kiện change. *@
<div class="panel-toolbar">
    <div class="search-box">
        <RadzenIcon Icon="search" aria-hidden="true" />
        <input class="form-control" value="@TuKhoa" data-tim-kiem @onchange="KhiNhapTuKhoa" placeholder="@GoiY" aria-label="@NhanTimKiem" />
    </div>
    @CacBoLoc
    <p class="ket-qua-tim-kiem" role="status">Hiển thị <strong>@SoHienThi.ToString("N0") / @TongSo.ToString("N0")</strong> bản ghi</p>
</div>

@code {
    [Parameter] public string TuKhoa { get; set; } = string.Empty;
    [Parameter] public EventCallback<ChangeEventArgs> KhiNhapTuKhoa { get; set; }
    [Parameter] public string? GoiY { get; set; }
    [Parameter] public string? NhanTimKiem { get; set; }

    // Các ô lọc theo từng trang (ví dụ chọn khoa, chọn lớp, nút "Bỏ bộ lọc").
    [Parameter] public RenderFragment? CacBoLoc { get; set; }

    [Parameter] public int SoHienThi { get; set; }
    [Parameter] public int TongSo { get; set; }
}
