@* Vai trò tệp: Nhập Excel theo loại dữ liệu: đọc, xem trước lỗi và xác nhận. *@
@inject DichVuNhapExcel Nhap
@inject DialogService HoiThoai
@inject IJSRuntime JS

@* Nhập Excel dùng chung (cán bộ, lớp, chuyên đề, phòng, điểm): tải mẫu → chọn tệp, xem trước lỗi từng dòng → xác nhận.
   Không ghi gì trước khi bấm Xác nhận; khi ghi, dịch vụ nghiệp vụ kiểm quyền và quy tắc lại từng dòng. *@
<ol class="buoc-nhap">
    <li class="@(dong is null ? "dang" : "xong")"><strong>1. Tải tệp mẫu</strong><span>@(Loai == LoaiNhap.Diem ? "Đã điền sẵn danh sách lớp và điểm hiện có; chỉ sửa cột điểm." : Loai == LoaiNhap.LichHoc ? "Giữ nguyên dòng tiêu đề; có danh sách chọn cho lớp, chuyên đề, cán bộ, phòng. Mỗi dòng là một buổi học." : "Giữ nguyên dòng tiêu đề; có danh sách chọn cho các cột mã, loại.")</span>
        <RadzenButton Text="Tải tệp mẫu" Icon="description" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="TaiMau" /></li>
    <li class="@(dong is null ? "dang" : "xong")"><strong>2. Chọn tệp đã điền</strong><span>Tệp .xlsx, tối đa 2.000 dòng, 5 MB.</span>
        <InputFile OnChange="ChonTep" accept=".xlsx" disabled="@dangDoc" /></li>
    <li class="@(dong is { Count: > 0 } ? "dang" : "")"><strong>3. Xem trước và xác nhận</strong><span>@(Loai == LoaiNhap.LichHoc ? "Hệ thống chặn trùng giờ giảng viên, phòng, lớp như khi xếp tay, nêu rõ lý do từng dòng." : "Chỉ các dòng hợp lệ được ghi.")</span></li>
</ol>

@if (dangDoc) { <div class="khung-xuong dong-xuong"></div> }
@if (loi is not null) { <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false">@loi</RadzenAlert> }
@if (dong is { Count: > 0 })
{
    <div class="tom-tat-diem-danh">
        <span class="o-tom-tat co-mat"><strong>@dong.Count(d => d.HopLe)</strong>dòng hợp lệ</span>
        <span class="o-tom-tat vang-kp"><strong>@dong.Count(d => !d.HopLe)</strong>dòng lỗi</span>
        <label class="chon-khoa"><RadzenCheckBox TValue="bool" @bind-Value="chiLoi" /> Chỉ xem dòng lỗi</label>
    </div>
    <div class="bang-cuon bang-xem-truoc">
        <table class="bang-diem">
            <thead><tr><th>Dòng</th><th>Mã</th><th>@(Loai == LoaiNhap.Diem ? "Họ tên" : "Tên")</th><th>@(Loai == LoaiNhap.Diem ? "Điểm" : "Thông tin")</th><th>Kết quả kiểm tra</th></tr></thead>
            <tbody>
                @foreach (var d in dong.Where(d => !chiLoi || !d.HopLe).Take(300))
                {
                    <tr class="@(d.HopLe ? "" : "dong-loi")">
                        <td class="so">@d.SoDong</td>
                        <td><span class="record-code">@d.Ma</span></td>
                        <td>@d.Ten</td><td>@d.MoTa</td>
                        <td>@if (d.HopLe) { <span class="nhan-xep-loai gioi">Hợp lệ</span> } else { <ul class="loi-dong">@foreach (var l in d.Loi) { <li>@l</li> }</ul> }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@if (ketQua is not null)
{
    <RadzenAlert AlertStyle="@(ketQua.Value.Loi.Count == 0 ? AlertStyle.Success : AlertStyle.Warning)" AllowClose="false">
        Đã nhập @ketQua.Value.ThanhCong dòng @DichVuNhapExcel.TenLoai(Loai).@if (ketQua.Value.Loi.Count > 0) { <span> @ketQua.Value.Loi.Count dòng bị từ chối khi ghi: @string.Join("; ", ketQua.Value.Loi.Take(5))</span> }
    </RadzenAlert>
}
<div class="thao-tac-bieu-mau">
    <RadzenButton Text="@(ketQua is null ? "Hủy" : "Đóng")" ButtonStyle="ButtonStyle.Light" Click="() => HoiThoai.Close(ketQua is null ? null : new KetQuaThaoTac(true, KetQuaNgan))" />
    @if (ketQua is null)
    {
        <RadzenButton Text="@($"Xác nhận nhập {dong?.Count(d => d.HopLe) ?? 0} dòng")" Icon="upload" ButtonStyle="ButtonStyle.Primary" Click="XacNhan" IsBusy="dangGhi" Disabled="@(dong is null || !dong.Any(d => d.HopLe))" />
    }
</div>

@* Xử lý phía thành phần: tham số, trạng thái và sự kiện phục vụ giao diện bên trên. *@
@code {
    [Parameter] public LoaiNhap Loai { get; set; }
    [Parameter] public string? MaLop { get; set; }
    [Parameter] public string? MaChuyenDe { get; set; }
    private List<DichVuNhapExcel.DongNhapChung>? dong;
    private string? loi;
    private bool dangDoc, dangGhi, chiLoi;
    private (int ThanhCong, List<string> Loi)? ketQua;
    private string KetQuaNgan => ketQua is { } k ? $"Đã nhập {k.ThanhCong} dòng {DichVuNhapExcel.TenLoai(Loai)} từ Excel{(k.Loi.Count > 0 ? $", {k.Loi.Count} dòng bị từ chối" : "")}." : "";

    // Khởi tạo và tải dữ liệu ban đầu theo luồng bất đồng bộ.
    protected override async Task OnInitializedAsync() => loi = await Nhap.KiemQuyenAsync(Loai, MaLop, MaChuyenDe);

    private async Task TaiMau()
    {
        var tep = await Nhap.TaoMauAsync(Loai, MaLop, MaChuyenDe);
        if (tep is null) { loi = await Nhap.KiemQuyenAsync(Loai, MaLop, MaChuyenDe); return; }
        var ten = Loai switch { LoaiNhap.CanBo => "can-bo", LoaiNhap.Lop => "lop", LoaiNhap.ChuyenDe => "chuyen-de", LoaiNhap.Phong => "phong", LoaiNhap.LichHoc => "lich-dao-tao", _ => $"diem-{MaLop}-{MaChuyenDe}" };
        await JS.InvokeVoidAsync("taiTep", $"mau-nhap-{ten}.xlsx", DichVuExcel.MimeXlsx, Convert.ToBase64String(tep));
    }

    private async Task ChonTep(InputFileChangeEventArgs e)
    {
        dangDoc = true; loi = null; dong = null; ketQua = null;
        try
        {
            using var ms = new MemoryStream();
            await using (var s = e.File.OpenReadStream(5 * 1024 * 1024)) await s.CopyToAsync(ms);
            ms.Position = 0;
            (dong, loi) = await Nhap.DocTepAsync(Loai, ms, MaLop, MaChuyenDe);
        }
        catch (IOException) { loi = "Tệp vượt quá 5 MB hoặc không đọc được."; }
        // Tệp hỏng hoặc không phải .xlsx thật: báo lỗi trong hộp thoại thay vì để lỗi làm sập kết nối (trang đơ).
        catch (Exception) { loi = "Không đọc được tệp. Hãy dùng đúng tệp Excel (.xlsx) theo mẫu tải về."; }
        finally { dangDoc = false; }
    }

    private async Task XacNhan()
    {
        if (dong is null) return;
        dangGhi = true;
        try { ketQua = await Nhap.XacNhanAsync(Loai, dong, MaLop, MaChuyenDe); }
        catch (Exception) { loi = "Không ghi được dữ liệu. Vui lòng thử lại; nếu vẫn lỗi, kiểm tra lại tệp."; }
        finally { dangGhi = false; }
    }
}
