@* Vai trò tệp: Trang lỗi: chỉ hiện mã yêu cầu để tra nhật ký máy chủ, không hiển thị chi tiết ngoại lệ cho người dùng. *@
@page "/Error"
@using System.Diagnostics

@* Trang lỗi: chỉ hiện mã yêu cầu để tra nhật ký máy chủ, không hiển thị chi tiết ngoại lệ cho người dùng. *@
<PageTitle>Đã xảy ra lỗi | Quản lý đào tạo</PageTitle>

<section class="empty-state">
    <RadzenIcon Icon="error_outline" class="empty-state-icon" />
    <h1>Đã xảy ra lỗi</h1>
    <p>Hệ thống không xử lý được yêu cầu của bạn. Hãy thử lại hoặc quay về trang chủ.</p>
    @if (ShowRequestId)
    {
        <p class="ma-yeu-cau">Mã yêu cầu: <code>@RequestId</code></p>
    }
    <RadzenLink Text="Về trang chủ" Icon="home" Path="/" class="btn btn-primary" />
</section>

@* Xử lý phía thành phần: tham số, trạng thái và sự kiện phục vụ giao diện bên trên. *@
@code{
    // HttpContext có thể không tồn tại trong mọi lần hiển thị component Blazor.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    // Khởi tạo trạng thái khi thành phần được tạo.
    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
