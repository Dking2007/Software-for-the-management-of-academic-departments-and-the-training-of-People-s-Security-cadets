@page "/"
@implements IDisposable
@using System.Globalization
@inject DichVuQuanLyDuLieuDemo DuLieu
@inject DichVuHocVu HocVu
@inject DichVuPhanQuyenDemo PhanQuyen
@inject DichVuTongQuan TongQuan
@inject DichVuThongBao ThongBaoDv

@* Trang chủ: dải chào mừng, thẻ số liệu (lối vào từng phân hệ) và hai biểu đồ cơ cấu.
   Mọi con số tính trực tiếp từ dữ liệu đang lưu trong CSDL. *@
<PageTitle>Trang chủ | Quản lý đào tạo</PageTitle>

@* Đầu bảng điều khiển (gọn, dữ liệu trước): ngày, lời chào theo giờ, một câu tóm tắt việc hôm nay theo vai trò và nút việc chính.
   Sau đó là các chỉ số "Hôm nay" bấm được để xử lý ngay; quy mô Học viện và biểu đồ đặt sau vì ít thay đổi. *@
<header class="bang-dau co-the" aria-labelledby="tieu-de-tong-quan">
    <div class="bang-dau-chu">
        <p class="bang-dau-ngay"><RadzenIcon Icon="calendar_today" />@ThuTrongTuan, @GioVietNam.ToString("dd/MM/yyyy")@if (nd.DaDangNhap) { <span>@nd.TenVaiTro · @PhamViHienThi</span> }</p>
        <h1 id="tieu-de-tong-quan">
            @if (nd.DaDangNhap) { @LoiChao<text>, </text><span class="hero-an-ten">@nd.Ten</span> }
            else { <text>Tổng quan</text> }
        </h1>
        <p class="bang-dau-tom-tat">@TomTat</p>
        <div class="bang-dau-nut">
            @{ var chinh = LoiVaoNhanh.FirstOrDefault(); }
            @if (chinh.Ten is not null)
            {
                <a class="nut-chinh" href="@chinh.DuongDan"><RadzenIcon Icon="@chinh.BieuTuong" /><span>@chinh.Ten</span></a>
            }
            <a class="nut-phu" href="/thong-bao"><RadzenIcon Icon="campaign" /><span>Văn bản</span>@if (soChuaDoc > 0) { <b aria-label="@($"{soChuaDoc} chưa đọc")">@soChuaDoc</b> }</a>
        </div>
    </div>
    @* Thẻ tài khoản: kiểu thẻ ngành có chip, quân hiệu, chữ cái đầu, vai trò, phạm vi và giờ bắt đầu phiên.
       Vào trang thì thẻ lật vào, vệt ánh kim lướt qua rồi lơ lửng nhẹ (CSS, tắt khi giảm chuyển động).
       Chỉ hiển thị thông tin đã có trong phiên đăng nhập; số thẻ là số trang trí, không phải số thật. *@
    @if (nd.DaDangNhap)
    {
        <aside class="the-tk" aria-label="Thẻ tài khoản: @nd.Ten, @nd.TenVaiTro, @PhamViHienThi">
            <div class="the-tk-mat" aria-hidden="true">
                <div class="the-tk-dau">
                    <img src="images/logo-hoc-vien-an-ninh.png" alt="" />
                    <span>HỌC VIỆN AN NINH NHÂN DÂN<small>Thẻ tài khoản hệ thống</small></span>
                </div>
                <div class="the-tk-than">
                    <span class="the-tk-anh">@ChuCaiDau</span>
                    <span class="the-tk-ten"><strong>@nd.Ten</strong><small>@nd.TenVaiTro</small><small>@PhamViHienThi</small></span>
                    <span class="the-tk-chip"></span>
                </div>
                <div class="the-tk-chan"><span><b></b>Phiên làm việc · @GioVietNam.ToString("HH:mm dd/MM")</span><span class="the-tk-so">@SoThe</span></div>
            </div>
        </aside>
    }
</header>

@* Bắt đầu nhanh theo vai trò (mục 11.4 của thiết kế): hàng lối tắt gọn. Chỉ là lối tắt, quyền thật vẫn kiểm ở trang đích. *@
@if (LoiVaoNhanh.Count() > 1)
{
    <nav class="tc-loi-tat" aria-label="Bắt đầu nhanh">
        @foreach (var (ten, bieuTuong, duongDan, moTa) in LoiVaoNhanh.Skip(1))
        {
            <a href="@duongDan" title="@moTa"><RadzenIcon Icon="@bieuTuong" /><span>@ten</span></a>
        }
    </nav>
}

@* Hôm nay: chỉ số cần hành động, mỗi ô mở đúng nơi xử lý. Trạng thái luôn có chữ đi kèm, không chỉ dựa vào màu. *@
<section class="tc-chi-so" aria-label="Hôm nay">
    @if (hocVu is { } hv)
    {
        <a class="the-kpi" href="/dao-tao/lich"><span class="the-kpi-nhan"><RadzenIcon Icon="today" />Buổi học hôm nay</span><strong data-chay-so>@hv.BuoiHomNay</strong><small>@hv.SoBuoiTuanNay buổi trong tuần này</small></a>
        <a class="the-kpi @(hv.BuoiChuaDiemDanh > 0 ? "canh-bao" : "tot")" href="@(nd.LaGiangVien ? "/giang-day" : "/dao-tao/lich")"><span class="the-kpi-nhan"><RadzenIcon Icon="@(hv.BuoiChuaDiemDanh > 0 ? "pending_actions" : "task_alt")" />Chưa điểm danh</span><strong>@hv.BuoiChuaDiemDanh</strong><small>@(hv.BuoiChuaDiemDanh > 0 ? "buổi đã qua, trong 2 tuần gần đây" : "Đã điểm danh đủ")</small></a>
    }
    @{ var canXuLy = canChuY.Count(m => m.SoLuong > 0); }
    @if (canChuY.Count > 0)
    {
        <a class="the-kpi @(canXuLy > 0 ? "canh-bao" : "tot")" href="#tieu-de-can-chu-y"><span class="the-kpi-nhan"><RadzenIcon Icon="@(canXuLy > 0 ? "error" : "verified")" />Cần chú ý</span><strong>@canXuLy</strong><small>trên @canChuY.Count mục theo dõi</small></a>
    }
    @if (nd.DaDangNhap)
    {
        <a class="the-kpi @(soChuaDoc > 0 ? "thong-tin" : "")" href="/thong-bao"><span class="the-kpi-nhan"><RadzenIcon Icon="mark_email_unread" />Văn bản chưa đọc</span><strong>@soChuaDoc</strong><small>trong @soVanBan văn bản gửi tới bạn</small></a>
    }
</section>

@* Bảng điều khiển: cần chú ý (số liệu tổng hợp theo vai trò), văn bản ưu tiên, hoạt động gần đây (Admin). *@
@if (canChuY.Count > 0 || uuTien.Count > 0)
{
    <div class="luoi-dieu-khien">
        @if (canChuY.Count > 0)
        {
            <section class="the-bieu-do the-can-chu-y" aria-labelledby="tieu-de-can-chu-y">
                <header class="dau-bieu-do"><div><h2 id="tieu-de-can-chu-y">Cần chú ý</h2><p>@(canChuY.Count(m => m.SoLuong > 0) == 0 ? "Không có việc tồn đọng." : $"{canChuY.Count(m => m.SoLuong > 0)} mục cần xử lý")</p></div></header>
                <ul class="ds-can-chu-y">
                    @foreach (var m in canChuY.OrderByDescending(m => m.SoLuong > 0))
                    {
                        <li class="@(m.SoLuong == 0 ? "xong" : m.MucDo)">
                            <a href="@m.DuongDan" title="@m.GoiY">
                                <RadzenIcon Icon="@(m.SoLuong == 0 ? "task_alt" : m.BieuTuong)" />
                                <span><strong>@m.Ten</strong><small>@(m.SoLuong == 0 ? "Đã ổn" : m.GoiY)</small></span>
                                <b>@m.SoLuong.ToString("N0")</b>
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }
        @if (uuTien.Count > 0)
        {
            <section class="the-bieu-do" aria-labelledby="tieu-de-uu-tien">
                <header class="dau-bieu-do"><div><h2 id="tieu-de-uu-tien">Văn bản ưu tiên</h2><p>Ghim, khẩn, quan trọng trước</p></div><a class="lien-ket-bieu-do" href="/thong-bao">Tất cả<RadzenIcon Icon="arrow_forward" /></a></header>
                <ul class="ds-uu-tien">
                    @foreach (var tb in uuTien)
                    {
                        var ngay = tb.DangLuc.ToOffset(TimeSpan.FromHours(7));
                        <li><a href="@($"/thong-bao?ma={tb.Ma}")">
                            <span class="tb-o-ngay"><strong>@ngay.ToString("dd")</strong><small>Th@(ngay.Month)</small></span>
                            <span class="tb-chu-muc">
                                <span class="tb-dong-nhan">@if (tb.Ghim) { <RadzenIcon Icon="push_pin" class="tb-ghim" /> }<span class="tb-loai">@tb.LoaiVanBan</span>@if (tb.SoKyHieu != "") { <span class="tb-so">@tb.SoKyHieu</span> }@if (tb.MucDo != "Thường") { <span class="tb-muc-do @(tb.MucDo == "Khẩn" ? "khan" : "quan-trong")">@tb.MucDo</span> }</span>
                                <strong>@tb.TieuDe</strong>
                            </span>
                        </a></li>
                    }
                </ul>
            </section>
        }
        @if (hoatDong.Count > 0)
        {
            <section class="the-bieu-do" aria-labelledby="tieu-de-hoat-dong">
                <header class="dau-bieu-do"><div><h2 id="tieu-de-hoat-dong">Hoạt động gần đây</h2><p>Từ nhật ký thao tác</p></div><a class="lien-ket-bieu-do" href="/quan-tri/nhat-ky">Nhật ký<RadzenIcon Icon="arrow_forward" /></a></header>
                <ul class="ds-hoat-dong">
                    @foreach (var (x, tenHd) in hoatDong)
                    {
                        <li><span class="nhan-hanh-dong @(x.HanhDong switch { "Thêm" => "them", "Sửa" => "sua", "Xoá" => "xoa", _ => "xem" })">@x.HanhDong</span><span><strong title="@tenHd">@tenHd</strong><small>@x.NguoiThucHien · @x.ThoiDiem.ToLocalTime().ToString("HH:mm dd/MM")</small></span></li>
                    }
                </ul>
            </section>
        }
    </div>
}

@* Quy mô Học viện: số liệu toàn hệ thống, ít thay đổi nên đặt sau phần việc hôm nay. *@
<section class="quy-mo" aria-labelledby="tieu-de-quy-mo">
    <header class="dau-muc"><h2 id="tieu-de-quy-mo">Quy mô Học viện</h2><p>Bấm một ô để mở danh sách tương ứng.</p></header>
    <section class="luoi-so-lieu" aria-label="Chỉ số hệ thống">
    @foreach (var muc in CacMucSoLieu)
    {
        <a class="the-so-lieu" href="@muc.DuongDan" aria-label="@($"{muc.Ten}: {muc.GiaTri?.ToString("N0") ?? "chưa có số liệu"}. Mở danh sách")">
            <span class="the-so-lieu-dau">
                <span class="the-so-lieu-nhan">@muc.Ten</span>
                <span class="the-so-lieu-bieu-tuong"><RadzenIcon Icon="@muc.BieuTuong" /></span>
            </span>
            <strong class="the-so-lieu-gia-tri" data-chay-so>@(muc.GiaTri?.ToString("N0") ?? "—")</strong>
            <span class="the-so-lieu-phu">@muc.MoTa<RadzenIcon Icon="arrow_outward" /></span>
        </a>
    }
</section>
</section>

@if (thongKe is { } tk)
{
    <div class="luoi-tong-quan">
        <section class="the-bieu-do" aria-labelledby="tieu-de-co-cau-hv">
            <header class="dau-bieu-do">
                <div>
                    <h2 id="tieu-de-co-cau-hv">Cơ cấu học viên</h2>
                    <p>Theo hệ đào tạo và khóa học · @tk.SoHocVien.ToString("N0") học viên</p>
                </div>
                <a class="lien-ket-bieu-do" href="/hoc-vien">Xem danh sách<RadzenIcon Icon="arrow_forward" /></a>
            </header>

            @* Thanh tỉ lệ: mỗi đoạn là một hệ, rộng theo phần trăm; chú giải bên dưới ghi tên, số và tỉ lệ. *@
            <div class="thanh-ti-le" role="img" aria-label="@string.Join("; ", CacHe.Select(h => $"{h.Ten}: {h.SoLuong:N0} học viên ({h.TiLe:P0})"))">
                @foreach (var he in CacHe)
                {
                    <span class="doan-ti-le @he.LopMau" style="flex-grow: @he.SoLuong.ToString(CultureInfo.InvariantCulture)" title="@($"{he.Ten}: {he.SoLuong:N0} học viên · {he.TiLe:P0}")"></span>
                }
            </div>
            <ul class="chu-giai">
                @foreach (var he in CacHe)
                {
                    <li><span class="o-mau @he.LopMau" aria-hidden="true"></span><span class="chu-giai-ten">@he.Ten</span><strong>@he.SoLuong.ToString("N0")</strong><span class="chu-giai-ti-le">@he.TiLe.ToString("P0")</span></li>
                }
            </ul>

            <h3 class="nhan-bieu-do">Học viên theo khóa học</h3>
            <BieuDoThanh CacDong="CacKhoaHoc" DonVi="học viên" />
        </section>

        <section class="the-bieu-do" aria-labelledby="tieu-de-lop-chuyen-nganh">
            <header class="dau-bieu-do">
                <div>
                    <h2 id="tieu-de-lop-chuyen-nganh">Lớp theo chuyên ngành</h2>
                    <p>@tk.SoLop.ToString("N0") lớp · @CacChuyenNganh.Count.ToString("N0") chuyên ngành</p>
                </div>
                <a class="lien-ket-bieu-do" href="/lop">Xem danh sách<RadzenIcon Icon="arrow_forward" /></a>
            </header>
            <BieuDoThanh CacDong="CacChuyenNganh" DonVi="lớp" NhanRong="true" />
            <dl class="so-lop-theo-he">
                @foreach (var he in CacLopTheoHe)
                {
                    <div><dt><span class="o-mau @LopMauHe(he.Key)" aria-hidden="true"></span>Lớp @he.Key.ToLower(new CultureInfo("vi-VN"))</dt><dd>@he.Value.ToString("N0")</dd></div>
                }
            </dl>
        </section>
    </div>
}



@code {
    private sealed record MucSoLieu(string Ten, string BieuTuong, string DuongDan, int? GiaTri, string MoTa);
    private sealed record PhanHe(string Ten, int SoLuong, double TiLe, string LopMau);

    // Thứ tự màu cố định theo hệ (không theo thứ hạng): Chính quy luôn xanh, Văn bằng 2 luôn vàng đồng.
    private static readonly string[] ThuTuHe = ["Chính quy", "Văn bằng 2"];
    private static string LopMauHe(string he) => Array.IndexOf(ThuTuHe, he) == 1 ? "mau-du-lieu-2" : "mau-du-lieu-1";

    private ThongKeQuanLy? thongKe;
    private List<PhanHe> CacHe = [];
    private List<BieuDoThanh.Dong> CacKhoaHoc = [];
    private List<BieuDoThanh.Dong> CacChuyenNganh = [];
    private List<KeyValuePair<string, int>> CacLopTheoHe = [];

    private (int BuoiHomNay, int BuoiChuaDiemDanh, int SoBuoiTuanNay)? hocVu;
    private List<DichVuTongQuan.MucCanChuY> canChuY = [];
    private List<ThongBao> uuTien = [];
    private List<DichVuTongQuan.HoatDong> hoatDong = [];
    private int soChuaDoc, soVanBan;
    private NguoiDungHienTai nd = NguoiDungHienTai.Khach;
    private IEnumerable<(string Ten, string BieuTuong, string DuongDan, string MoTa)> LoiVaoNhanh
    {
        get
        {
            if (nd.LaGiangVien) yield return ("Giảng dạy của tôi", "co_present", "/giang-day", "Buổi dạy hôm nay, điểm danh, nhập điểm");
            if (nd.LaHocVien) yield return ("Học tập của tôi", "person", "/cua-toi", "Lịch học, điểm danh, kết quả");
            if (nd.CoQuyenVung("DaoTao") && !nd.LaAdmin) yield return ("Xếp lịch đào tạo", "edit_calendar", "/dao-tao/lich", "Lịch tuần theo lớp, phòng học");
            if (nd.CoQuyenVung("Lop") && !nd.LaAdmin) yield return ("Danh sách lớp", "groups", "/quan-ly-hoc-vien/lop", "Lớp và học viên thuộc phạm vi của bạn");
            if (nd.CoQuyenVung("Khoa") && !nd.LaAdmin) yield return ("Chuyên môn giảng dạy", "menu_book", "/dao-tao/chuyen-de", "Chuyên đề và giáo viên đủ điều kiện");
            if (nd.LaAdmin)
            {
                yield return ("Quản lý khoa", "account_balance", "/khoa", "Khoa, tổ chuyên môn, cán bộ");
                yield return ("Quản lý đào tạo", "school", "/dao-tao", "Chuyên ngành, khóa, chương trình");
                yield return ("Tài khoản và phân quyền", "manage_accounts", "/quan-tri/tai-khoan", "Cấp, khóa tài khoản, đổi vai trò");
                yield return ("Nhật ký thao tác", "history", "/quan-tri/nhat-ky", "Ai đã sửa gì, lúc nào");
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        TaiSoLieu();
        DuLieu.DuLieuDaThayDoi += KhiDuLieuDoi;
        nd = await PhanQuyen.LayNguoiDungAsync();
        if (nd.DaDangNhap && nd.VaiTro != "Guest") hocVu = await HocVu.LayTongHopAsync();
        canChuY = await TongQuan.LayCanChuYAsync();
        uuTien = await ThongBaoDv.LayUuTienAsync();
        hoatDong = await TongQuan.LayHoatDongGanDayAsync();
        if (nd.DaDangNhap)
        {
            var dsTb = await ThongBaoDv.LayDanhSachChoToiAsync();
            var daDoc = await ThongBaoDv.LayDaDocAsync();
            soChuaDoc = dsTb.Count(x => !daDoc.Contains(x.Ma)); soVanBan = dsTb.Count;
        }
    }

    // Nếu dữ liệu tạm thời không nhất quán thì ẩn số liệu và biểu đồ (hiện "—"), không làm hỏng cả trang chủ.
    private void TaiSoLieu()
    {
        try
        {
            thongKe = DuLieu.LayThongKe();
            var tk = thongKe;
            var tong = Math.Max(1, tk.HocVienTheoHe.Values.Sum());
            CacHe = tk.HocVienTheoHe
                .OrderBy(x => Array.IndexOf(ThuTuHe, x.Key) is var i && i < 0 ? int.MaxValue : i)
                .Select(x => new PhanHe(x.Key, x.Value, (double)x.Value / tong, LopMauHe(x.Key)))
                .ToList();

            // Khóa học tô màu theo hệ của lớp; xếp Chính quy trước rồi theo số khóa tăng dần (D53 → D58, K3 → K6).
            var cacLop = DuLieu.LayDanhSachLop();
            var heCuaKhoaHoc = cacLop.GroupBy(l => l.KhoaHoc).ToDictionary(g => g.Key, g => g.First().HeDaoTao);
            CacKhoaHoc = tk.HocVienTheoKhoaHoc
                .Select(x => (x.Key, x.Value, He: heCuaKhoaHoc.GetValueOrDefault(x.Key, "")))
                .OrderBy(x => Array.IndexOf(ThuTuHe, x.He) is var i && i < 0 ? int.MaxValue : i)
                .ThenBy(x => int.TryParse(x.Key[1..], out var so) ? so : int.MaxValue)
                .Select(x => new BieuDoThanh.Dong(x.Key, x.Value, LopMauHe(x.He), x.He))
                .ToList();

            // Gộp lớp của cả hai hệ theo tên chuyên ngành, nhiều lớp nhất lên đầu; chỉ một chuỗi số liệu nên dùng một màu.
            CacChuyenNganh = cacLop
                .GroupBy(l => l.ChuyenNganh)
                .OrderByDescending(g => g.Count()).ThenBy(g => g.Key, StringComparer.Create(new CultureInfo("vi-VN"), false))
                .Select(g => new BieuDoThanh.Dong(g.Key, g.Count(), "mau-du-lieu-1", null))
                .ToList();
            CacLopTheoHe = cacLop
                .GroupBy(l => l.HeDaoTao)
                .OrderBy(g => Array.IndexOf(ThuTuHe, g.Key) is var i && i < 0 ? int.MaxValue : i)
                .Select(g => KeyValuePair.Create(g.Key, g.Count()))
                .ToList();
        }
        catch (Exception)
        {
            thongKe = null; CacHe = []; CacKhoaHoc = []; CacChuyenNganh = []; CacLopTheoHe = [];
        }
    }

    private static DateTimeOffset GioVietNam => DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(7));
    private static string LoiChao => GioVietNam.Hour switch { < 11 => "Chào buổi sáng", < 13 => "Chào buổi trưa", < 18 => "Chào buổi chiều", _ => "Chào buổi tối" };

    /// <summary>Một câu tóm tắt việc hôm nay, ghép từ đúng những số liệu người này được xem.</summary>
    private MarkupString TomTat
    {
        get
        {
            var y = new List<string>();
            if (hocVu is { } hv)
            {
                y.Add($"<b>{hv.BuoiHomNay:N0}</b> buổi học hôm nay");
                if (hv.BuoiChuaDiemDanh > 0) y.Add($"<b>{hv.BuoiChuaDiemDanh:N0}</b> buổi đã qua chưa điểm danh");
            }
            var canXuLy = canChuY.Count(m => m.SoLuong > 0);
            if (canXuLy > 0) y.Add($"<b>{canXuLy}</b> mục cần chú ý");
            if (soChuaDoc > 0) y.Add($"<b>{soChuaDoc}</b> văn bản chưa đọc");
            if (y.Count == 0) return new("Mọi việc đang ổn, không có gì tồn đọng. Chúc một ngày làm việc hiệu quả.");
            var cau = y.Count == 1 ? y[0] : string.Join(", ", y.Take(y.Count - 1)) + " và " + y[^1];
            return new($"Hôm nay có {cau}.");
        }
    }
    private static string ThuTrongTuan { get { var t = GioVietNam.ToString("dddd", new CultureInfo("vi-VN")); return char.ToUpper(t[0]) + t[1..]; } }
    private string ChuCaiDau => string.IsNullOrWhiteSpace(nd.Ten) ? "?" : new string(nd.Ten.Where(char.IsLetterOrDigit).Take(2).ToArray()).ToUpperInvariant();
    // Số thẻ ổn định theo tên tài khoản (chỉ để trang trí, không phải số thật).
    private string SoThe => $"Số {GioVietNam.Year}-{nd.Ten.Aggregate(17, (h, c) => (h * 31 + c) % 10000):D4}";
    private string PhamViHienThi => nd.VaiTro switch
    {
        "Admin" => "Phạm vi: toàn hệ thống",
        "Manager" => nd.PhamVi switch { "Khoa" => "Phạm vi: mảng quản lý khoa", "DaoTao" => "Phạm vi: mảng đào tạo", "Lop" => "Phạm vi: mảng học viên", _ => "Phạm vi: " + nd.PhamVi },
        "GiangVien" or "HocVien" when nd.PhamVi != "" => "Mã: " + nd.PhamVi,
        _ => "Chỉ xem danh sách được phép"
    };

    // Ngày theo giờ Việt Nam (UTC+7), ví dụ "Thứ Tư, 04/11/2026".
    private static string NgayHomNay
    {
        get
        {
            var ngay = DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(7)).ToString("dddd, dd/MM/yyyy", new CultureInfo("vi-VN"));
            return char.ToUpper(ngay[0]) + ngay[1..];
        }
    }

    // Dòng phụ dưới mỗi số liệu được suy ra từ chính dữ liệu mẫu; không có số liệu thì để mô tả chung.
    private IEnumerable<MucSoLieu> CacMucSoLieu
    {
        get
        {
            var tk = thongKe;
            return
            [
                new("Khoa", "account_balance", "/khoa", tk?.SoKhoa, "Đơn vị đào tạo"),
                new("Tổ chuyên môn", "account_tree", "/khoa/to", tk?.SoTo, tk is { SoKhoa: > 0 } ? $"Thuộc {tk.SoKhoa:N0} khoa" : "Theo từng khoa"),
                new("Cán bộ, giảng viên", "badge", "/khoa/can-bo", tk?.SoCanBo, tk is { SoTo: > 0 } ? $"Trung bình {(double)tk.SoCanBo / tk.SoTo:N1} người/tổ" : "Giảng dạy và quản lý"),
                new("Lớp đào tạo", "groups", "/lop", tk?.SoLop, tk is { HocVienTheoHe.Count: > 0 } ? $"{tk.HocVienTheoHe.Count:N0} hệ đào tạo" : "Theo hệ và khóa học"),
                new("Học viên", "school", "/hoc-vien", tk?.SoHocVien, tk is { SoLop: > 0 } ? $"Trung bình {(double)tk.SoHocVien / tk.SoLop:N0} học viên/lớp" : "Đang theo học")
            ];
        }
    }

    // Số liệu cập nhật khi tab khác thêm hoặc xóa bản ghi; hủy đăng ký khi rời trang.
    private void KhiDuLieuDoi() => _ = InvokeAsync(() => { TaiSoLieu(); StateHasChanged(); });
    public void Dispose() => DuLieu.DuLieuDaThayDoi -= KhiDuLieuDoi;
}
