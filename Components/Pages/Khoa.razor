@* Vai trò tệp: Danh sách khoa, lãnh đạo, sĩ số và thao tác quản lý. *@
@inject TuyChonGiaoDien TuyChon
@implements IDisposable
@page "/khoa"
@using KhoaModel = Nhom2_BTL.Models.Khoa
@using ToModel = Nhom2_BTL.Models.ToChuyenMon
@inject DichVuQuanLyDuLieuDemo DuLieu
@inject DichVuPhanQuyenDemo PhanQuyen
@inject DichVuBaoCaoExcel BaoCao
@inject DialogService HoiThoai
@inject DichVuTruongTuyChinh TruongTuyChinh
@inject NotificationService ThongBao

@* Danh sách khoa hiển thị lãnh đạo và số tổ; hồ sơ tổ, cán bộ có mục riêng trong sidebar. *@
<PageTitle>Khoa | Hệ thống quản lý Khoa/Lớp đào tạo</PageTitle>
<DauTrang TieuDe="Danh sách khoa" MoTa="Quản lý khoa và các vị trí lãnh đạo trực thuộc.">
    <ThaoTac><NutXuatExcel TaoTep="@(async () => (byte[]?)await BaoCao.XuatKhoaAsync())" TenTep="danh-sach-khoa" />@if (duocChinhSua) { <RadzenButton Icon="add" Text="@TuyChon.Dich("Thêm khoa")" ButtonStyle="ButtonStyle.Primary" Click="ThemKhoa" /> }</ThaoTac>
</DauTrang>
<RadzenCard class="directory-panel">
    <ThanhCongCu TuKhoa="@tuKhoa" KhiNhapTuKhoa="NhapTuKhoa" GoiY="Tìm theo mã hoặc tên khoa" NhanTimKiem="Tìm khoa" SoHienThi="@DanhSachHienThi.Count()" TongSo="@danhSachKhoa.Count" />
    <RadzenDataGrid @ref="bang" GridLines="DataGridGridLines.Horizontal" TItem="KhoaModel" Data="@DanhSachHienThi" AllowPaging="true" PageSize="10" PageSizeOptions="@(new int[] { 5, 10, 20, 30, 40 })" PageSizeText="@TuyChon.Dich("dòng / trang")" AllowSorting="true" PagerHorizontalAlign="HorizontalAlign.Center" AllowColumnResize="true" EmptyText="Không tìm thấy khoa phù hợp." class="directory-grid">
        <Columns>
            <RadzenDataGridColumn TItem="KhoaModel" Title="@TuyChon.Dich("STT")" Width="3rem" Sortable="false"><Template Context="dong">@SoThuTu(dong)</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="KhoaModel" Property="@nameof(KhoaModel.MaKhoa)" Title="@TuyChon.Dich("Mã khoa")" Width="5.5rem"><Template Context="khoa"><span class="record-code">@khoa.MaKhoa</span></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="KhoaModel" Property="@nameof(KhoaModel.TenKhoa)" Title="@TuyChon.Dich("Tên khoa")" Width="19rem"><Template Context="khoa"><TheXemNhanh Loai="Khoa" Ma="@khoa.MaKhoa" Class="ten-khoa-khong-gach-chan"><RadzenLink class="ten-khoa-khong-gach-chan" Path="@($"/khoa/{Uri.EscapeDataString(khoa.MaKhoa)}/to")" Text="@khoa.TenKhoa" /></TheXemNhanh></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="KhoaModel" Title="@TuyChon.Dich("Trưởng khoa")" Width="11rem"><Template Context="khoa"><TenCanBo MaCanBo="@khoa.MaTruongKhoa" /></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="KhoaModel" Title="@TuyChon.Dich("Phó khoa")" Width="11rem"><Template Context="khoa"><div class="cac-pho-khoa"><TenCanBo MaCanBo="@khoa.MaPhoKhoa" /><TenCanBo MaCanBo="@khoa.MaPhoKhoaThuHai" /></div></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="KhoaModel" Title="@TuyChon.Dich("Số tổ")" TextAlign="TextAlign.Center" Width="4rem"><Template Context="khoa">@cacTo.Count(to => to.MaKhoa == khoa.MaKhoa)</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="KhoaModel" Property="@nameof(KhoaModel.SiSo)" Title="@TuyChon.Dich("Sĩ số cán bộ")" TextAlign="TextAlign.Center" Width="7rem" />
            @foreach (var tr in moRong.Truong.Where(t => t.HienTrenBang)) { <RadzenDataGridColumn TItem="KhoaModel" Title="@tr.Ten" Width="10rem" Sortable="false"><Template Context="x"><span class="o-mo-rong-bang">@moRong.HienThi(tr, x.MaKhoa)</span></Template></RadzenDataGridColumn> }
            @if (duocChinhSua) { <RadzenDataGridColumn TItem="KhoaModel" Title="@TuyChon.Dich("Thao tác")" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" CssClass="cot-thao-tac" HeaderCssClass="cot-thao-tac" Sortable="false" Width="6rem"><Template Context="khoa"><div class="actions-cell"><RadzenButton class="nut-sua-dong" Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" title="@TuyChon.Dich("Sửa")" aria-label="@($"Sửa khoa {khoa.MaKhoa}")" Click="@(() => SuaKhoa(khoa))" /><RadzenButton class="nut-xoa-dong" Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" title="@TuyChon.Dich("Xóa")" aria-label="@($"Xóa khoa {khoa.MaKhoa}")" Click="@(() => XoaKhoa(khoa))" /></div></Template></RadzenDataGridColumn> }
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@* Xử lý phía thành phần: tham số, trạng thái và sự kiện phục vụ giao diện bên trên. *@
@code {
    private DichVuTruongTuyChinh.BangMoRong moRong = DichVuTruongTuyChinh.BangMoRong.Rong;
    [CascadingParameter(Name = "NgonNguGiaoDien")] public string NgonNguGiaoDien { get; set; } = "vi";
    // Cập nhật sau khi người dùng ngừng gõ 300 ms và trở về trang đầu để nhìn thấy kết quả.
    private async Task NhapTuKhoa(ChangeEventArgs e)
    {
        tuKhoa = e.Value?.ToString() ?? string.Empty;
        if (bang is not null) await bang.FirstPage(true);
    }

    private RadzenDataGrid<KhoaModel>? bang;
    private int SoThuTu(KhoaModel banGhi) => (bang?.View.ToList().IndexOf(banGhi) ?? -1) + 1;

    // Mỗi tab chỉ giữ bản sao; cập nhật từ kho chung và hủy đăng ký khi component kết thúc.
    private void KhiDuLieuDoi() => _ = InvokeAsync(() => { TaiDuLieu(); StateHasChanged(); });
    // Giải phóng tài nguyên và các đăng ký theo dõi khi kết thúc sử dụng.
    public void Dispose() => DuLieu.DuLieuDaThayDoi -= KhiDuLieuDoi;

    private List<KhoaModel> danhSachKhoa = [];
    private List<ToModel> cacTo = [];
    private string tuKhoa = string.Empty;
    private bool duocChinhSua;

    private IEnumerable<KhoaModel> DanhSachHienThi => TimKiemMo.Loc(danhSachKhoa, tuKhoa, khoa => [khoa.TenKhoa, khoa.MaKhoa]);

    // Khởi tạo và tải dữ liệu ban đầu theo luồng bất đồng bộ.
    protected override async Task OnInitializedAsync() { moRong = await TruongTuyChinh.LayBangAsync("Khoa"); duocChinhSua = await PhanQuyen.CoQuyenVungAsync("Khoa"); TaiDuLieu(); DuLieu.DuLieuDaThayDoi += KhiDuLieuDoi; }
    // Nạp dữ liệu cho các danh sách và bộ lọc của thành phần.
    private void TaiDuLieu() { danhSachKhoa = DuLieu.LayDanhSachKhoa().ToList(); cacTo = DuLieu.LayDanhSachTo().ToList(); }

    private async Task ThemKhoa()
    {
        var ketQua = await HoiThoai.OpenAsync<BieuMauKhoa>("Thêm khoa", new Dictionary<string, object> { [nameof(BieuMauKhoa.DuLieuBanDau)] = new KhoaModel() }, new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = false });
        if (ketQua is KetQuaThaoTac daLuu) await ThongBaoKetQua(daLuu);
    }
    private async Task SuaKhoa(KhoaModel khoa)
    {
        var ketQua = await HoiThoai.OpenAsync<BieuMauKhoa>("Sửa khoa", new Dictionary<string, object> { [nameof(BieuMauKhoa.DuLieuBanDau)] = khoa.TaoBanSao(), [nameof(BieuMauKhoa.DangSua)] = true }, new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = false });
        if (ketQua is KetQuaThaoTac daLuu) await ThongBaoKetQua(daLuu);
    }
    private async Task XoaKhoa(KhoaModel khoa)
    {
        var xacNhan = await HoiThoai.Confirm($"Bạn sắp xóa khoa {khoa.TenKhoa} ({khoa.MaKhoa}). Thao tác không thể hoàn tác.", "Xác nhận xóa", new ConfirmOptions { OkButtonText = "Xóa", CancelButtonText = "Hủy", CssClass = "hop-xac-nhan-xoa" });
        if (xacNhan == true) await ThongBaoKetQua(await DuLieu.XoaKhoaAsync(khoa.MaKhoa));
    }
    // Thông báo kết quả thao tác và cập nhật dữ liệu hiển thị.
    private async Task ThongBaoKetQua(KetQuaThaoTac ketQua)
    { moRong = await TruongTuyChinh.LayBangAsync("Khoa");
        ThongBao.Notify(new NotificationMessage { Severity = ketQua.ThanhCong ? NotificationSeverity.Success : NotificationSeverity.Warning, Summary = ketQua.ThanhCong ? "Hoàn tất" : "Không thể thực hiện", Duration = 5000, Detail = ketQua.ThongBao });
        TaiDuLieu(); await InvokeAsync(StateHasChanged);
    }
}
