@inject TuyChonGiaoDien TuyChon
@page "/quan-tri/tai-khoan"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject Radzen.DialogService HopThoai
@inject DichVuTaiKhoan TaiKhoan
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider XacThuc

@* Trang quản trị tài khoản: bố cục giống các trang danh sách (đầu trang, thanh công cụ, bảng trong một khung). Chỉ đổi giao diện, quyền Admin vẫn do thuộc tính Authorize và DichVuTaiKhoan kiểm tra. *@
<PageTitle>Quản lý tài khoản | Hệ thống quản lý Khoa/Lớp đào tạo</PageTitle>
<DauTrang TieuDe="Quản lý tài khoản và phân quyền" MoTa="Tài khoản đăng ký mới có quyền Guest. Đổi mật khẩu, quyền hoặc khóa tài khoản sẽ vô hiệu hóa phiên cũ.">
    <ThaoTac><RadzenButton Text="@TuyChon.Dich("Thêm tài khoản")" Icon="person_add" ButtonStyle="ButtonStyle.Primary" Click="Them" Disabled="dangLuu" /></ThaoTac>
</DauTrang>

<div role="status">
    @if (!string.IsNullOrEmpty(thongBao))
    {
        <RadzenAlert class="thong-bao-trang" AlertStyle="@(thongBao.StartsWith("Đã") ? AlertStyle.Success : AlertStyle.Warning)" AllowClose="false">@thongBao</RadzenAlert>
    }
</div>

@if (dangSua)
{
    <section class="bieu-mau-tai-khoan" aria-labelledby="tieu-de-bieu-mau-tk">
        <h2 id="tieu-de-bieu-mau-tk">@(maSua is null ? "Thêm tài khoản" : "Sửa tài khoản")</h2>
        @if (maSua is not null) { <p class="ghi-chu-bieu-mau">Mã cố định: @maSua</p> }
        <div class="form-grid">
            <div><label for="ten-tk">Tên đăng nhập</label><RadzenTextBox id="ten-tk" @bind-Value="ten" MaxLength="64" autocomplete="off" Style="width:100%" /></div>
            <div><label for="mk-tk">@(maSua is null ? "Mật khẩu ban đầu" : "Mật khẩu mới (để trống nếu giữ nguyên)")</label><RadzenPassword id="mk-tk" @bind-Value="matKhau" autocomplete="new-password" Style="width:100%" /></div>
            <div><label for="vai-tro">Vai trò</label><RadzenDropDown TValue="string" id="vai-tro" Data="@cacVaiTro" TextProperty="Ten" ValueProperty="Ma" @bind-Value="vaiTro" Style="width:100%" /></div>
            @if (vaiTro == "Manager")
            {
                <div><label for="pham-vi">Phạm vi quản lý</label><RadzenDropDown TValue="string" id="pham-vi" Data="@cacPhamVi" TextProperty="Ten" ValueProperty="Ma" @bind-Value="phamVi" Style="width:100%" /></div>
            }
            <p class="ghi-chu-bieu-mau toan-hang">Mật khẩu phải có cả chữ và số. Không yêu cầu độ dài, chữ hoa hay ký tự đặc biệt. Không thể xem mật khẩu hiện tại.</p>
            <label class="chon-khoa toan-hang"><RadzenCheckBox TValue="bool" @bind-Value="khoa" /> Khóa tài khoản</label>
        </div>
        <div class="thao-tac-bieu-mau">
            <RadzenButton Text="@TuyChon.Dich("Hủy")" Click="Huy" Disabled="dangLuu" ButtonStyle="ButtonStyle.Light" />
            <RadzenButton Text="@TuyChon.Dich("Lưu")" Icon="save" Click="Luu" Disabled="dangLuu" ButtonStyle="ButtonStyle.Primary" />
        </div>
    </section>
}

@if (danhSach is null)
{
    <p class="bang-trong" role="status">Đang tải...</p>
}
else
{
    var ketQua = KetQua.ToList();
    <div class="directory-panel">
        <div class="panel-toolbar">
            <div class="search-box">
                <RadzenIcon Icon="search" aria-hidden="true" />
                <input id="tim" class="form-control" @bind="tim" @bind:event="oninput" placeholder="Tìm mã hoặc tên tài khoản" aria-label="@TuyChon.Dich("Tìm tài khoản")" />
            </div>
            <RadzenDropDown TValue="string" id="loc-vai-tro" class="filter-dropdown" Data="@cacVaiTroLoc" TextProperty="Ten" ValueProperty="Ma" @bind-Value="locVaiTro" aria-label="@TuyChon.Dich("Lọc theo vai trò")" />
            <p class="ket-qua-tim-kiem" role="status">Hiển thị <strong>@ketQua.Count.ToString("N0") / @danhSach.Count.ToString("N0")</strong> tài khoản</p>
        </div>
        <RadzenDataGrid TItem="TaiKhoan" Data="@ketQua" AllowPaging="true" PageSize="10" PageSizeOptions="@(new int[] { 5, 10, 20, 30, 40 })" PageSizeText="@TuyChon.Dich("dòng / trang")" AllowSorting="true" AllowColumnResize="true" PagerHorizontalAlign="HorizontalAlign.Center" GridLines="DataGridGridLines.Horizontal" EmptyText="Không có tài khoản phù hợp." class="directory-grid">
            <Columns>
                <RadzenDataGridColumn TItem="TaiKhoan" Property="Id" Title="@TuyChon.Dich("Mã tài khoản")" Width="10rem"><Template Context="u"><span class="record-code">@u.Id</span></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TaiKhoan" Property="UserName" Title="@TuyChon.Dich("Tên đăng nhập")" Width="10rem" />
                <RadzenDataGridColumn TItem="TaiKhoan" Property="VaiTro" Title="@TuyChon.Dich("Vai trò")" TextAlign="TextAlign.Center" Width="10rem"><Template Context="u"><span class="nhan-trang-thai hoat-dong">@TenVaiTro(u.VaiTro)</span></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TaiKhoan" Property="PhamVi" Title="@TuyChon.Dich("Phạm vi")" Width="10rem"><Template Context="u">@(u.PhamVi == "Khoa" ? "Quản lý Khoa" : u.PhamVi == "Lop" ? "Quản lý Lớp đào tạo" : "—")</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TaiKhoan" Title="@TuyChon.Dich("Mật khẩu")" Sortable="false" Width="10rem"><Template Context="u">@if (KhoiTaoTaiKhoanMau.LaTaiKhoanMau(u)) { <span class="record-code">demo123</span> } else { <span class="phu-dong" title="@TuyChon.Dich("Chỉ lưu bản băm; dùng Sửa để đặt mật khẩu mới")">Không thể xem lại</span> }</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TaiKhoan" Title="@TuyChon.Dich("Thao tác")" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" CssClass="cot-thao-tac" HeaderCssClass="cot-thao-tac" Sortable="false" Width="10rem">
                    <Template Context="u">
                        @if (KhoiTaoTaiKhoanMau.LaTaiKhoanMau(u)) { <span class="phu-dong">Tài khoản mẫu cố định</span> }
                        else
                        {
                            <div class="actions-cell">
                                <RadzenButton class="nut-sua-dong" Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" title="@TuyChon.Dich("Sửa")" aria-label="@($"Sửa tài khoản {u.UserName}")" Click="@(() => Sua(u))" Disabled="dangLuu" />
                                <RadzenButton class="nut-xoa-dong" Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" title="@TuyChon.Dich("Xóa")" aria-label="@($"Xóa tài khoản {u.UserName}")" Click="@(() => Xoa(u))" Disabled="dangLuu" />
                            </div>
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
}
@code {
    [CascadingParameter(Name = "NgonNguGiaoDien")] public string NgonNguGiaoDien { get; set; } = "vi";
    private sealed record LuaChon(string Ma, string Ten);
    private readonly LuaChon[] cacVaiTro = [new("Guest", "Người xem"), new("Manager", "Cán bộ quản lý"), new("Admin", "Quản trị viên")];
    private readonly LuaChon[] cacVaiTroLoc = [new("", "Tất cả vai trò"), new("Guest", "Người xem"), new("Manager", "Cán bộ quản lý"), new("Admin", "Quản trị viên")];
    private readonly LuaChon[] cacPhamVi = [new("", "Chọn phạm vi"), new("Khoa", "Quản lý Khoa"), new("Lop", "Quản lý Lớp đào tạo")];
    // Giá trị vai trò trong dữ liệu giữ nguyên (Admin/Manager/Guest); chỉ nhãn hiển thị là tiếng Việt.
    private static string TenVaiTro(string? vaiTro) => vaiTro switch { "Admin" => "Quản trị viên", "Manager" => "Cán bộ quản lý", "Guest" => "Người xem", _ => vaiTro ?? "" };
    private List<TaiKhoan>? danhSach;
    private string tim = "", locVaiTro = "", thongBao = "", ten = "", matKhau = "", vaiTro = "Guest", phamVi = "";
    private string? maSua;
    private bool dangLuu, dangSua, khoa;
    private IEnumerable<TaiKhoan> KetQua => (danhSach ?? []).Where(u => (u.Id.Contains(tim.Trim(), StringComparison.OrdinalIgnoreCase) || (u.UserName ?? "").Contains(tim.Trim(), StringComparison.OrdinalIgnoreCase)) && (locVaiTro == "" || u.VaiTro == locVaiTro));
    protected override async Task OnInitializedAsync() => await TaiLai();
    private async Task TaiLai() {
        try { danhSach = await TaiKhoan.DanhSach((await XacThuc.GetAuthenticationStateAsync()).User); }
        catch { danhSach = []; thongBao = "Không tải được danh sách. Kiểm tra quyền và đăng nhập lại."; }
    }
    private void Them() { maSua = null; ten = matKhau = phamVi = ""; vaiTro = "Guest"; khoa = false; dangSua = true; }
    private void Sua(TaiKhoan u) { maSua = u.Id; ten = u.UserName ?? ""; vaiTro = u.VaiTro; phamVi = u.PhamVi; khoa = u.BiKhoa; matKhau = ""; dangSua = true; }
    private void Huy() { matKhau = ""; dangSua = false; }
    private async Task Luu() {
        if (await HopThoai.Confirm("Lưu thay đổi tài khoản?", "Xác nhận", new Radzen.ConfirmOptions { OkButtonText = "Lưu", CancelButtonText = "Hủy" }) != true) return;
        dangLuu = true;
        try { thongBao = await TaiKhoan.LuuTaiKhoan((await XacThuc.GetAuthenticationStateAsync()).User, maSua, ten, matKhau, vaiTro, phamVi, khoa); if (thongBao.StartsWith("Đã")) Huy(); await TaiLai(); }
        catch { thongBao = "Không lưu được. Vui lòng tải lại và thử lại."; }
        finally { matKhau = ""; dangLuu = false; }
    }
    private async Task Xoa(TaiKhoan u) {
        if (await HopThoai.Confirm($"Xóa tài khoản {u.UserName}? Thao tác không thể hoàn tác.", "Xác nhận xóa", new Radzen.ConfirmOptions { OkButtonText = "Xóa", CancelButtonText = "Hủy", CssClass = "hop-xac-nhan-xoa" }) != true) return;
        dangLuu = true;
        try { thongBao = await TaiKhoan.Xoa((await XacThuc.GetAuthenticationStateAsync()).User, u.Id); await TaiLai(); }
        catch { thongBao = "Không xóa được. Vui lòng thử lại."; }
        finally { dangLuu = false; }
    }
}
