@page "/quan-tri/tai-khoan"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject Radzen.DialogService HopThoai
@inject DichVuTaiKhoan TaiKhoan
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider XacThuc
<PageTitle>Quản lý tài khoản</PageTitle>
<h1>Quản lý tài khoản và phân quyền</h1>
<p>Tài khoản đăng ký mới có quyền Guest. Đổi mật khẩu, quyền hoặc khóa tài khoản sẽ vô hiệu hóa phiên cũ.</p>
<div class="bo-loc-tai-khoan">
    <div><label for="tim">Tìm mã hoặc tên tài khoản</label><input id="tim" class="form-control" @bind="tim" @bind:event="oninput" /></div>
    <div><label for="loc-vai-tro">Vai trò</label><select id="loc-vai-tro" class="form-select" @bind="locVaiTro"><option value="">Tất cả</option><option>Admin</option><option>Manager</option><option>Guest</option></select></div>
    <RadzenButton Text="Thêm tài khoản" Icon="person_add" Click="Them" Disabled="dangLuu" />
</div>
<p role="status">@thongBao</p>
@if (dangSua) {
<section class="bieu-mau-tai-khoan">
    <h2>@(maSua is null ? "Thêm tài khoản" : "Sửa tài khoản")</h2>
    @if (maSua is not null) { <p>Mã cố định: @maSua</p> }
    <label for="ten-tk">Tên đăng nhập</label><input id="ten-tk" class="form-control" @bind="ten" maxlength="64" autocomplete="off" />
    <label for="mk-tk">@(maSua is null ? "Mật khẩu ban đầu" : "Mật khẩu mới (để trống nếu giữ nguyên)")</label><input id="mk-tk" class="form-control" type="password" @bind="matKhau" autocomplete="new-password" />
    <p>Mật khẩu phải có cả chữ và số. Không yêu cầu độ dài, chữ hoa hay ký tự đặc biệt. Không thể xem mật khẩu hiện tại.</p>
    <label for="vai-tro">Vai trò</label><select id="vai-tro" class="form-select hop-vai-tro" @bind="vaiTro"><option>Guest</option><option>Manager</option><option>Admin</option></select>
    @if (vaiTro == "Manager") { <label for="pham-vi">Phạm vi quản lý</label><select id="pham-vi" class="form-select" @bind="phamVi"><option value="">Chọn phạm vi</option><option value="Khoa">Quản lý Khoa</option><option value="Lop">Quản lý Lớp đào tạo</option></select> }
    <label class="my-3"><input type="checkbox" @bind="khoa" /> Khóa tài khoản</label>
    <div><RadzenButton Text="Lưu" Icon="save" Click="Luu" Disabled="dangLuu" /><RadzenButton Text="Hủy" Click="Huy" Disabled="dangLuu" ButtonStyle="ButtonStyle.Light" /></div>
</section>
}
@if (danhSach is null) { <p>Đang tải...</p> }
else {
<div class="bang-tai-khoan"><table class="table align-middle"><thead><tr><th>Mã tài khoản</th><th>Tên đăng nhập</th><th class="text-center">Vai trò</th><th>Phạm vi</th><th>Mật khẩu</th><th class="text-center">Khóa</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var u in KetQua) {
<tr @key="u.Id"><td class="ma-tai-khoan">@u.Id</td><td>@u.UserName</td><td class="text-center"><span class="nhan-vai-tro-tk">@u.VaiTro</span></td><td>@(u.PhamVi == "Khoa" ? "Quản lý Khoa" : u.PhamVi == "Lop" ? "Quản lý Lớp đào tạo" : "—")</td><td>@if (KhoiTaoTaiKhoanMau.LaTaiKhoanMau(u)) { <span>demo123</span> } else { <span title="Chỉ lưu bản băm; dùng Sửa để đặt mật khẩu mới">Không thể xem lại</span> }</td><td class="text-center"><input type="checkbox" checked="@u.BiKhoa" disabled aria-label="Trạng thái khóa của @u.UserName" /></td><td>
@if (KhoiTaoTaiKhoanMau.LaTaiKhoanMau(u)) { <span>Tài khoản mẫu cố định</span> }
else { <RadzenButton Text="Sửa" Icon="edit" Click="@(() => Sua(u))" Disabled="dangLuu" /><RadzenButton Text="Xóa" Icon="delete" Click="@(() => Xoa(u))" Disabled="dangLuu" ButtonStyle="ButtonStyle.Danger" /> }
</td></tr>
}
</tbody></table></div>
@if (!KetQua.Any()) { <p>Không có tài khoản phù hợp.</p> }
}
@code {
    private List<TaiKhoan>? danhSach;
    private string tim = "", locVaiTro = "", thongBao = "", ten = "", matKhau = "", vaiTro = "Guest", phamVi = "";
    private string? maSua;
    private bool dangLuu, dangSua, khoa;
    private IEnumerable<TaiKhoan> KetQua => (danhSach ?? []).Where(u => (u.Id.Contains(tim.Trim(), StringComparison.OrdinalIgnoreCase) || (u.UserName ?? "").Contains(tim.Trim(), StringComparison.OrdinalIgnoreCase)) && (locVaiTro == "" || u.VaiTro == locVaiTro));
    protected override async Task OnInitializedAsync() => await TaiLai();
    private async Task TaiLai() {
        try { danhSach = await TaiKhoan.DanhSach((await XacThuc.GetAuthenticationStateAsync()).User); }
        catch { danhSach = []; thongBao = "Không tải được danh sách. Kiểm tra quyền và đăng nhập lại."; }
    }
    private void Them() { maSua = null; ten = matKhau = phamVi = ""; vaiTro = "Guest"; khoa = false; dangSua = true; }
    private void Sua(TaiKhoan u) { maSua = u.Id; ten = u.UserName ?? ""; vaiTro = u.VaiTro; phamVi = u.PhamVi; khoa = u.BiKhoa; matKhau = ""; dangSua = true; }
    private void Huy() { matKhau = ""; dangSua = false; }
    private async Task Luu() {
        if (await HopThoai.Confirm("Lưu thay đổi tài khoản?", "Xác nhận", new Radzen.ConfirmOptions { OkButtonText = "Lưu", CancelButtonText = "Hủy" }) != true) return;
        dangLuu = true;
        try { thongBao = await TaiKhoan.LuuTaiKhoan((await XacThuc.GetAuthenticationStateAsync()).User, maSua, ten, matKhau, vaiTro, phamVi, khoa); if (thongBao.StartsWith("Đã")) Huy(); await TaiLai(); }
        catch { thongBao = "Không lưu được. Vui lòng tải lại và thử lại."; }
        finally { matKhau = ""; dangLuu = false; }
    }
    private async Task Xoa(TaiKhoan u) {
        if (await HopThoai.Confirm($"Xóa tài khoản {u.UserName}? Thao tác không thể hoàn tác.", "Xác nhận xóa", new Radzen.ConfirmOptions { OkButtonText = "Xóa", CancelButtonText = "Hủy" }) != true) return;
        dangLuu = true;
        try { thongBao = await TaiKhoan.Xoa((await XacThuc.GetAuthenticationStateAsync()).User, u.Id); await TaiLai(); }
        catch { thongBao = "Không xóa được. Vui lòng thử lại."; }
        finally { dangLuu = false; }
    }
}

