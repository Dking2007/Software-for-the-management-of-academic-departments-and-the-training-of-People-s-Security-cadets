@implements IDisposable
@page "/khoa/to"
@using ToModel = Nhom2_BTL.Models.ToChuyenMon
@inject DichVuQuanLyDuLieuDemo DuLieu
@inject DichVuPhanQuyenDemo PhanQuyen
@inject DialogService HoiThoai
@inject NotificationService ThongBao

@* Danh sách tổ hiển thị quan hệ với khoa, tổ trưởng và tổ phó. *@
<PageTitle>Tổ chuyên môn | Quản lý đào tạo</PageTitle>
<DauTrang TieuDe="Tổ chuyên môn" MoTa="Các tổ trực thuộc khoa và người phụ trách.">
    <ThaoTac>@if (duocChinhSua) { <RadzenButton Icon="add" Text="Thêm tổ" ButtonStyle="ButtonStyle.Primary" Click="ThemTo" /> }</ThaoTac>
</DauTrang>
<RadzenCard class="directory-panel">
    <ThanhCongCu TuKhoa="@tuKhoa" KhiNhapTuKhoa="NhapTuKhoa" GoiY="Tìm tên tổ, mã tổ hoặc khoa" NhanTimKiem="Tìm tổ" SoHienThi="@DanhSachHienThi.Count()" TongSo="@danhSachTo.Count" />
    <RadzenDataGrid @ref="bang" GridLines="DataGridGridLines.Horizontal" TItem="ToModel" Data="@DanhSachHienThi" AllowPaging="true" PageSize="12" AllowSorting="true" PagerHorizontalAlign="HorizontalAlign.Center" AllowColumnResize="true" EmptyText="Không tìm thấy tổ phù hợp." class="directory-grid">
        <Columns>
            <RadzenDataGridColumn TItem="ToModel" Title="STT" Width="5rem" Sortable="false"><Template Context="dong">@SoThuTu(dong)</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ToModel" Property="@nameof(ToModel.MaTo)" Title="Mã tổ" Width="12rem"><Template Context="to"><span class="record-code">@to.MaTo</span></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ToModel" Property="@nameof(ToModel.TenTo)" Title="Tên tổ" Width="12rem" />
            <RadzenDataGridColumn TItem="ToModel" Title="Khoa" Width="12rem"><Template Context="to">@DuLieu.LayTenKhoa(to.MaKhoa)</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ToModel" Title="Tổ trưởng" Width="12rem"><Template Context="to"><TenCanBo MaCanBo="@to.MaToTruong" /></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ToModel" Title="Tổ phó" Width="12rem"><Template Context="to"><TenCanBo MaCanBo="@to.MaToPho" /></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ToModel" Property="@nameof(ToModel.SiSo)" Title="Sĩ số cán bộ" TextAlign="TextAlign.Right" Width="9rem" />
            @if (duocChinhSua) { <RadzenDataGridColumn TItem="ToModel" Title="Thao tác" Sortable="false" Width="7rem"><Template Context="to"><div class="actions-cell"><RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" title="Sửa" aria-label="@($"Sửa tổ {to.MaTo}")" Click="@(() => SuaTo(to))" /><RadzenButton class="nut-xoa-dong" Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" title="Xóa" aria-label="@($"Xóa tổ {to.MaTo}")" Click="@(() => XoaTo(to))" /></div></Template></RadzenDataGridColumn> }
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    // Cập nhật sau khi người dùng ngừng gõ 300 ms và trở về trang đầu để nhìn thấy kết quả.
    private async Task NhapTuKhoa(ChangeEventArgs e)
    {
        tuKhoa = e.Value?.ToString() ?? string.Empty;
        if (bang is not null) await bang.FirstPage(true);
    }

    private RadzenDataGrid<ToModel>? bang;
    private int SoThuTu(ToModel banGhi) => (bang?.View.ToList().IndexOf(banGhi) ?? -1) + 1;

    // Mỗi tab chỉ giữ bản sao; cập nhật từ kho chung và hủy đăng ký khi component kết thúc.
    private void KhiDuLieuDoi() => _ = InvokeAsync(() => { TaiDuLieu(); StateHasChanged(); });
    public void Dispose() => DuLieu.DuLieuDaThayDoi -= KhiDuLieuDoi;

private List<ToModel> danhSachTo = [];
private string tuKhoa = string.Empty;
private bool duocChinhSua;
private IEnumerable<ToModel> DanhSachHienThi => danhSachTo.Where(to => string.IsNullOrWhiteSpace(tuKhoa) || to.MaTo.Contains(tuKhoa.Trim(), StringComparison.OrdinalIgnoreCase) || to.TenTo.Contains(tuKhoa.Trim(), StringComparison.OrdinalIgnoreCase) || DuLieu.LayTenKhoa(to.MaKhoa).Contains(tuKhoa.Trim(), StringComparison.OrdinalIgnoreCase));
protected override async Task OnInitializedAsync() { duocChinhSua = await PhanQuyen.CoQuyenVungAsync("Khoa"); TaiDuLieu(); DuLieu.DuLieuDaThayDoi += KhiDuLieuDoi; }
private void TaiDuLieu() => danhSachTo = DuLieu.LayDanhSachTo().ToList();
private async Task ThemTo() { var kq = await HoiThoai.OpenAsync<BieuMauTo>("Thêm tổ", new Dictionary<string, object> { [nameof(BieuMauTo.DuLieuBanDau)] = new ToModel(), [nameof(BieuMauTo.DanhSachKhoa)] = DuLieu.LayDanhSachKhoa() }, new DialogOptions { Width = "650px", CloseDialogOnOverlayClick = false }); if (kq is KetQuaThaoTac daLuu) await ThongBaoKetQua(daLuu); }
private async Task SuaTo(ToModel to) { var kq = await HoiThoai.OpenAsync<BieuMauTo>("Sửa tổ", new Dictionary<string, object> { [nameof(BieuMauTo.DuLieuBanDau)] = to.TaoBanSao(), [nameof(BieuMauTo.DanhSachKhoa)] = DuLieu.LayDanhSachKhoa(), [nameof(BieuMauTo.DangSua)] = true }, new DialogOptions { Width = "650px", CloseDialogOnOverlayClick = false }); if (kq is KetQuaThaoTac daLuu) await ThongBaoKetQua(daLuu); }
private async Task XoaTo(ToModel to) { var ok = await HoiThoai.Confirm($"Bạn sắp xóa tổ {to.TenTo} ({to.MaTo}). Thao tác không thể hoàn tác.", "Xác nhận xóa", new ConfirmOptions { OkButtonText = "Xóa", CancelButtonText = "Hủy", CssClass = "hop-xac-nhan-xoa" }); if (ok == true) await ThongBaoKetQua(await DuLieu.XoaToAsync(to.MaTo)); }
private async Task ThongBaoKetQua(KetQuaThaoTac kq) { ThongBao.Notify(new NotificationMessage { Severity = kq.ThanhCong ? NotificationSeverity.Success : NotificationSeverity.Warning, Summary = kq.ThanhCong ? "Hoàn tất" : "Không thể thực hiện", Duration = 5000, Detail = kq.ThongBao }); TaiDuLieu(); await InvokeAsync(StateHasChanged); }
}




