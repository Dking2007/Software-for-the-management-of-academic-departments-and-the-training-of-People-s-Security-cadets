@* Vai trò tệp: Tổng quan đào tạo và lối vào các chức năng quản lý. *@
@inject TuyChonGiaoDien TuyChon
@page "/dao-tao"
@page "/dao-tao/chuyen-nganh"
@page "/dao-tao/khoa-hoc"
@implements IDisposable
@attribute [Authorize]
@inject DichVuQuanLyDuLieuDemo DuLieu
@inject NavigationManager DieuHuong
@inject DichVuDaoTao DaoTao

@* Quản lý đào tạo theo cấp, đi từ ngoài vào trong:
   - Chuyên ngành: nhóm theo hệ đào tạo → biết mỗi hệ đào tạo những ngành nào.
   - Khoá và niên khoá: nhóm theo năm nhập học → trong năm có những hệ, khoá nào → lớp.
   Số liệu tổng hợp tự động từ danh sách lớp hiện hành. *@
<PageTitle>Quản lý đào tạo | Hệ thống quản lý Khoa/Lớp đào tạo</PageTitle>
<DauTrang TieuDe="@TieuDe" MoTa="@MoTa" />
@if (LaTongQuan) { <h2 class="tieu-de-khu-vuc">Lối tắt nhanh</h2><DieuHuongDaoTao /> }

@if (LaTongQuan)
{
    <div class="so-lieu-dao-tao">
        <RadzenCard><span>Hệ đào tạo</span><strong>@cacLop.Select(l => l.HeDaoTao).Distinct().Count()</strong></RadzenCard>
        <RadzenCard><span>Chuyên ngành</span><strong>@cacLop.Select(l => l.ChuyenNganh).Distinct().Count()</strong></RadzenCard>
        <RadzenCard><span>Khóa học</span><strong>@cacLop.Select(l => (l.HeDaoTao, l.KhoaHoc)).Distinct().Count()</strong></RadzenCard>
        <RadzenCard><span>Lớp đào tạo</span><strong>@cacLop.Count</strong></RadzenCard>
        <RadzenCard><span>Chuyên đề</span><strong>@soChuyenDe</strong></RadzenCard>
        <RadzenCard><span>Buổi học tuần này</span><strong>@soBuoiTuan</strong></RadzenCard>
    </div>
}

@if (!LaKhoaHoc)
{
    <section class="khu-dao-tao">
        <div class="dau-khu-thu-gon">
            <h2 class="tieu-de-khu-vuc">@(LaTongQuan ? "Hệ đào tạo và chuyên ngành" : "Chuyên ngành theo hệ đào tạo")</h2>
            <span><button type="button" @onclick="() => DatMoHe(true)">Mở tất cả</button><button type="button" @onclick="() => DatMoHe(false)">Thu gọn tất cả</button></span>
        </div>
        <div class="luoi-he" @key="phienBanHe">
            @foreach (var he in CacHe)
            {
                var lopHe = cacLop.Where(l => l.HeDaoTao == he).ToList();
                <details class="khoi-he he-@MaHe(he)" open="@(moHe ?? he == CacHe.First())">
                    <summary>
                        <span class="bieu-tuong-he"><RadzenIcon Icon="@(he == "Văn bằng 2" ? "workspace_premium" : he == "Liên thông" ? "swap_horiz" : "school")" /></span>
                        <div><h3>Hệ @he.ToLowerInvariant()</h3><small>@lopHe.Select(l => l.ChuyenNganh).Distinct().Count() chuyên ngành · @lopHe.Count lớp · @lopHe.Sum(l => l.SiSo).ToString("N0") học viên</small></div>
                        <RadzenIcon Icon="expand_more" class="mui-ten-thu-gon" />
                    </summary>
                    <ul class="ds-nganh">
                        @foreach (var nganh in lopHe.GroupBy(l => l.ChuyenNganh).OrderByDescending(g => g.Count()))
                        {
                            <li>
                                <div class="dau-nganh"><strong>@nganh.Key</strong><span>@nganh.Count() lớp · @nganh.Sum(l => l.SiSo).ToString("N0") HV</span></div>
                                @if (!LaTongQuan)
                                {
                                    <div class="tags-tin">
                                        @foreach (var kh in nganh.GroupBy(l => l.KhoaHoc).OrderByDescending(g => g.Key))
                                        {
                                            <a class="tag-tin" href="@($"/quan-ly-hoc-vien/lop")" title="@string.Join(", ", kh.Select(l => l.MaLop))">@kh.Key: @kh.Count() lớp</a>
                                        }
                                    </div>
                                }
                                <div class="thanh-ti-le-nho"><span style="width:@(Math.Round(100.0 * nganh.Count() / Math.Max(1, lopHe.Count)).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                            </li>
                        }
                    </ul>
                </details>
            }
        </div>
    </section>
}

@if (LaKhoaHoc || LaTongQuan)
{
    <section class="khu-dao-tao">
        <div class="dau-khu-thu-gon">
            <h2 class="tieu-de-khu-vuc">Khoá và niên khoá theo năm nhập học</h2>
            <span><button type="button" @onclick="() => DatMoNam(true)">Mở tất cả</button><button type="button" @onclick="() => DatMoNam(false)">Thu gọn tất cả</button></span>
        </div>
        <ol class="dong-thoi-gian-nam" @key="phienBanNam">
            @foreach (var nam in CacNam)
            {
                var lopNam = cacLop.Where(l => NamNhapHoc(l) == nam).ToList();
                <li class="@(nam == DateTime.Today.Year ? "nam-nay" : "")">
                  <details open="@(moNam ?? nam == CacNam.First())">
                    <summary>
                        <div class="moc-nam"><strong>@nam</strong><small>Niên khoá @nam–@(nam + 4)</small></div>
                        <span class="tom-tat-nam">@foreach (var kh in lopNam.GroupBy(l => (l.HeDaoTao, l.KhoaHoc))) { <span class="tag-tin">@kh.Key.KhoaHoc · @kh.Key.HeDaoTao</span> }</span>
                        <span class="so-nam">@lopNam.Count lớp · @lopNam.Sum(l => l.SiSo).ToString("N0") HV</span>
                        <RadzenIcon Icon="expand_more" class="mui-ten-thu-gon" />
                    </summary>
                    <div class="cac-khoa-trong-nam">
                        @foreach (var kh in lopNam.GroupBy(l => (l.HeDaoTao, l.KhoaHoc)).OrderBy(g => Array.IndexOf(QuyTacDuLieu.CacHeDaoTao, g.Key.HeDaoTao)))
                        {
                            <article class="the-khoa-hoc he-@MaHe(kh.Key.HeDaoTao)">
                                <header><strong>Khoá @kh.Key.KhoaHoc</strong><span class="nhan-trang-thai hoat-dong">@kh.Key.HeDaoTao</span></header>
                                <p>@kh.Count() lớp · @kh.Sum(l => l.SiSo).ToString("N0") học viên</p>
                                @if (LaKhoaHoc)
                                {
                                    <div class="tags-tin">@foreach (var l in kh.OrderBy(l => l.MaLop.Length).ThenBy(l => l.MaLop)) { <a class="tag-tin" href="@($"/quan-ly-hoc-vien/lop/{l.MaLop}")" title="@l.ChuyenNganh">@l.MaLop</a> }</div>
                                }
                                else
                                {
                                    <small class="phu-dong">@string.Join(" · ", kh.Select(l => l.ChuyenNganh).Distinct())</small>
                                }
                            </article>
                        }
                    </div>
                  </details>
                </li>
            }
        </ol>
    </section>
}

@* Xử lý phía thành phần: tham số, trạng thái và sự kiện phục vụ giao diện bên trên. *@
@code {
    [CascadingParameter(Name = "NgonNguGiaoDien")] public string NgonNguGiaoDien { get; set; } = "vi";
    private List<LopDaoTao> cacLop = [];
    private int soChuyenDe, soBuoiTuan;
    // null = mặc định (chỉ mở mục đầu); true/false = người dùng bấm Mở/Thu gọn tất cả. Đổi @key để dựng lại thẻ details.
    private bool? moHe, moNam;
    private int phienBanHe, phienBanNam;
    private void DatMoHe(bool mo) { moHe = mo; phienBanHe++; }
    private void DatMoNam(bool mo) { moNam = mo; phienBanNam++; }
    private string DuongDan => DieuHuong.ToBaseRelativePath(DieuHuong.Uri).Split('?', '#')[0].Trim('/');
    private bool LaTongQuan => DuongDan == "dao-tao";
    private bool LaKhoaHoc => DuongDan == "dao-tao/khoa-hoc";
    private string TieuDe => LaKhoaHoc ? "Khoá và niên khoá" : DuongDan == "dao-tao/chuyen-nganh" ? "Chuyên ngành" : "Quản lý đào tạo";
    private string MoTa => LaKhoaHoc ? "Theo năm nhập học: mỗi năm có những hệ và khoá nào, gồm các lớp nào." : DuongDan == "dao-tao/chuyen-nganh" ? "Mỗi hệ đào tạo những chuyên ngành nào, bao nhiêu lớp ở từng khoá." : "Hệ đào tạo, chuyên ngành, khoá, chuyên đề, chương trình, lịch và phòng học.";
    private IEnumerable<string> CacHe => cacLop.Select(l => l.HeDaoTao).Distinct().OrderBy(h => Array.IndexOf(QuyTacDuLieu.CacHeDaoTao, h));
    private IEnumerable<int> CacNam => cacLop.Select(NamNhapHoc).Distinct().OrderByDescending(n => n);
    private static int NamNhapHoc(LopDaoTao l) => int.TryParse(l.NienKhoa.Split('–')[0], out var nam) ? nam : 0;
    private static string MaHe(string he) => he switch { "Văn bằng 2" => "vb2", "Liên thông" => "lt", _ => "cq" };
    // Khởi tạo và tải dữ liệu ban đầu theo luồng bất đồng bộ.
    protected override async Task OnInitializedAsync()
    {
        TaiDuLieu(); DuLieu.DuLieuDaThayDoi += KhiDuLieuDoi;
        DieuHuong.LocationChanged += KhiDoiTrang;
        soChuyenDe = (await DaoTao.LayChuyenDeAsync()).Count;
        var dau = QuyTacHocVu.DauTuan(DateTime.Today);
        soBuoiTuan = (await DaoTao.LayLichAsync(dau, dau.AddDays(6))).Count;
    }
    // Nạp dữ liệu cho các danh sách và bộ lọc của thành phần.
    private void TaiDuLieu() => cacLop = DuLieu.LayDanhSachLop().ToList();
    // Làm mới thành phần khi dữ liệu nghiệp vụ thay đổi.
    private void KhiDuLieuDoi() => _ = InvokeAsync(() => { TaiDuLieu(); StateHasChanged(); });
    // Ba đường dẫn /dao-tao, /dao-tao/chuyen-nganh, /dao-tao/khoa-hoc dùng chung component không tham số:
    // Blazor không render lại khi chuyển giữa chúng, nên tự render theo sự kiện đổi địa chỉ.
    private void KhiDoiTrang(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(() => { moHe = null; moNam = null; phienBanHe++; phienBanNam++; StateHasChanged(); });
    // Giải phóng tài nguyên và các đăng ký theo dõi khi kết thúc sử dụng.
    public void Dispose() { DuLieu.DuLieuDaThayDoi -= KhiDuLieuDoi; DieuHuong.LocationChanged -= KhiDoiTrang; }
}
