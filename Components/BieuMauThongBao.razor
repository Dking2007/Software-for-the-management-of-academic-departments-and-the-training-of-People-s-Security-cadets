@* Vai trò tệp: Biểu mẫu nhập và chỉnh sửa thông tin văn bản, thông báo. *@
@inject DichVuThongBao DichVu
@inject Radzen.DialogService HopThoai

@* Biểu mẫu soạn/sửa văn bản thông báo. Là component riêng, tự giữ bản nháp của mình:
   - Khi mở trong hộp thoại (TrongHopThoai = true): lưu xong thì tự đóng hộp và trả mã văn bản; Hủy hoặc dấu × trả null.
   - Khi đặt ngay trên trang (đăng mới): báo về trang cha qua KhiXong.
   Trước đây biểu mẫu là một RenderFragment của trang cha vẽ bên trong hộp thoại; khi lưu, trang cha xoá bản nháp
   trước khi hộp thoại đóng, hộp thoại vẽ lại với dữ liệu rỗng và làm sập kết nối (trang đơ, phải tải lại). *@
<div class="noi-dung-hop-soan @(TrongHopThoai ? "dang-sua" : "")">
    <EditForm Model="banNhap" OnValidSubmit="Luu" OnInvalidSubmit="BaoLoiBieuMau" class="soan-thong-bao">
        <DataAnnotationsValidator />
        @if (!TrongHopThoai) { <div class="dau-hop-soan"><h2>Đăng văn bản mới</h2></div> }
        <div class="tb-luoi-the-thuc">
            <div><label for="loai-vb">Loại văn bản</label><RadzenDropDown TValue="string" Name="loai-vb" Data="@DichVuThongBao.CacLoaiVanBan" @bind-Value="banNhap.LoaiVanBan" Change="DoiLoai" Style="width:100%" Disabled="dangBan" /></div>
            <div><label for="so-ky-hieu">Số / ký hiệu</label><InputText id="so-ky-hieu" class="form-control" @bind-Value="banNhap.SoKyHieu" maxlength="40" placeholder="Ví dụ 126/KH-HV" /></div>
            <div><label for="muc-do">Mức độ</label><RadzenDropDown TValue="string" Name="muc-do" Data="@DichVuThongBao.CacMucDo" @bind-Value="banNhap.MucDo" Style="width:100%" Disabled="dangBan" /></div>
            <div><label for="hieu-luc">Hiển thị đến ngày (để trống: không hạn)</label><RadzenDatePicker TValue="DateTime?" @bind-Value="hieuLucNhap" DateFormat="dd/MM/yyyy" AllowClear="true" Style="width:100%" /></div>
            <div><label for="nguoi-ky">Người ký</label><InputText id="nguoi-ky" class="form-control" @bind-Value="banNhap.NguoiKy" maxlength="100" /></div>
            <div><label for="co-quan">Cơ quan ban hành</label><InputText id="co-quan" class="form-control" @bind-Value="banNhap.CoQuanBanHanh" maxlength="150" /></div>
        </div>
        <label class="chon-khoa"><InputCheckbox @bind-Value="banNhap.Ghim" /> Ghim lên đầu danh sách và trang chủ</label>
        <label for="tieu-de-tin">Tiêu đề</label><InputText id="tieu-de-tin" class="form-control" @bind-Value="banNhap.TieuDe" maxlength="200" aria-describedby="loi-tieu-de-tin" />
        <div id="loi-tieu-de-tin"><ValidationMessage For="@(() => banNhap.TieuDe)" /></div>
        <label for="trich-yeu">Trích yếu (một dòng, hiện ở danh sách)</label><InputText id="trich-yeu" class="form-control" @bind-Value="banNhap.TrichYeu" maxlength="300" />
        <label for="noi-dung-tin">Nội dung</label><InputTextArea id="noi-dung-tin" class="form-control" rows="7" @bind-Value="banNhap.NoiDung" maxlength="20000" aria-describedby="loi-noi-dung-tin" />
        <div id="loi-noi-dung-tin"><ValidationMessage For="@(() => banNhap.NoiDung)" /></div>
        <label for="tag-bai">Nơi nhận: khoa</label>
        <RadzenDropDown Name="tag-bai" InputAttributes="@(new Dictionary<string, object> { ["id"] = "tag-bai" })" TValue="IEnumerable<string>" @bind-Value="tagsKhoa" Data="@(danhMucTags.Where(x => x.Ma.StartsWith("khoa:")))" TextProperty="Ten" ValueProperty="Ma" Multiple="true" AllowFiltering="true" AllowClear="true" Placeholder="Không chọn: gửi toàn hệ thống" Style="width:100%" />
        <label>Nơi nhận: lớp đào tạo (chọn nhanh Hệ → Khoá → Lớp)</label>
        <ChonPhamViLop Id="them-lop-tin" @bind-Value="phamViThem" />
        <RadzenButton Text="Thêm nhóm lớp đã chọn" Icon="add" ButtonStyle="ButtonStyle.Light" Click="ThemPhamVi" />
        <div class="tags-tin">@foreach (var tag in tagsChon.Where(x => !x.StartsWith("khoa:"))) { <button type="button" class="tag-tin" @onclick="() => BoPhamVi(tag)" aria-label="@("Bỏ " + TenTag(tag))">@TenTag(tag) ×</button> }</div>
        <small>Không chọn khoa hay nhóm lớp: gửi toàn hệ thống. Học viên chỉ nhận văn bản gửi tới lớp/khoá/hệ của mình; giảng viên nhận văn bản của khoa mình và lớp mình dạy.</small>
        <label for="anh-tin">Ảnh đính kèm (PNG, JPEG, WebP; tối đa 3 MB)</label>
        <InputFile id="anh-tin" OnChange="ChonAnh" accept="image/png,image/jpeg,image/webp" disabled="@(dangBan || dangTaiAnh)" />
        @if (dangTaiAnh) { <p class="trang-thai-tai-anh" role="status"><RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" /> Đang đọc ảnh, vui lòng chờ…</p> }
        @if (anhXemTruoc is not null)
        {
            <img class="anh-xem-truoc" src="@anhXemTruoc" alt="Ảnh đang chọn cho văn bản" data-phong-to tabindex="0" title="Bấm để xem ảnh lớn" />
            <RadzenButton Text="Bỏ ảnh" Icon="close" Click="BoAnh" ButtonStyle="ButtonStyle.Light" Disabled="@(dangBan || dangTaiAnh)" />
        }
        @if (!string.IsNullOrEmpty(loi))
        {
            <div class="phan-hoi-tin phan-hoi-loi" role="alert">
                <strong>Chưa lưu được văn bản</strong><p>@loi</p>
                <ValidationSummary />
            </div>
        }
        <div class="hanh-dong-tin">
            <RadzenButton Text="@(dangBan ? "Đang lưu…" : banNhap.Ma == Guid.Empty ? "Đăng văn bản" : "Lưu văn bản")" Icon="save" ButtonType="ButtonType.Submit" IsBusy="dangBan" BusyText="Đang lưu…" Disabled="@(dangBan || dangTaiAnh)" />
            <RadzenButton Text="Hủy" Click="Huy" ButtonStyle="ButtonStyle.Light" Disabled="dangBan" />
        </div>
    </EditForm>
</div>

@* Xử lý phía thành phần: tham số, trạng thái và sự kiện phục vụ giao diện bên trên. *@
@code {
    [Parameter, EditorRequired] public ThongBao DuLieuBanDau { get; set; } = new();
    [Parameter] public bool TrongHopThoai { get; set; }
    /// <summary>Chỉ dùng khi đặt trên trang: mã văn bản vừa lưu, hoặc null nếu bấm Hủy.</summary>
    [Parameter] public EventCallback<Guid?> KhiXong { get; set; }

    private ThongBao banNhap = new();
    private List<TagThongBao> danhMucTags = [];
    private IEnumerable<string> tagsChon = [];
    private string phamViThem = "lop:*";
    private DateTime? hieuLucNhap;
    private byte[]? anhMoi;
    private string? anhXemTruoc, loi;
    private bool xoaAnh, dangBan, dangTaiAnh;

    private IEnumerable<string> tagsKhoa
    {
        get => tagsChon.Where(x => x.StartsWith("khoa:"));
        set => tagsChon = tagsChon.Where(x => !x.StartsWith("khoa:")).Concat(value ?? []).Distinct().ToList();
    }

    // Khởi tạo trạng thái khi thành phần được tạo.
    protected override void OnInitialized()
    {
        banNhap = DuLieuBanDau.TaoBanSao();
        tagsChon = [.. banNhap.Tags];
        hieuLucNhap = banNhap.HieuLucDen?.ToOffset(TimeSpan.FromHours(7)).Date;
        anhXemTruoc = banNhap.Anh;
        danhMucTags = DichVu.LayTags();
    }

    private string TenTag(string ma) => danhMucTags.FirstOrDefault(x => x.Ma == ma)?.Ten ?? ma;
    private void ThemPhamVi() => tagsChon = tagsChon.Append(phamViThem).Distinct().ToList();
    private void BoPhamVi(string tag) => tagsChon = tagsChon.Where(x => x != tag).ToList();
    private void DoiLoai(object _)
    {
        // Gợi ý lại số/ký hiệu theo loại khi đang soạn mới.
        if (banNhap.Ma == Guid.Empty) banNhap.SoKyHieu = DichVu.GoiYSoKyHieu(banNhap.LoaiVanBan);
    }
    private void BaoLoiBieuMau(EditContext _) => loi = "Vui lòng kiểm tra các ô được đánh dấu đỏ bên trên và sửa theo hướng dẫn.";
    private void BoAnh() { anhMoi = null; anhXemTruoc = null; xoaAnh = true; }

    private async Task ChonAnh(InputFileChangeEventArgs e)
    {
        dangTaiAnh = true; loi = null;
        try
        {
            if (e.File.Size > DichVuThongBao.GioiHanAnh) throw new ArgumentException();
            using var boNho = new MemoryStream();
            await using (var tep = e.File.OpenReadStream(DichVuThongBao.GioiHanAnh)) await tep.CopyToAsync(boNho);
            var duLieu = boNho.ToArray();
            anhXemTruoc = DichVuThongBao.TaoAnh(duLieu); // kiểm tra chữ ký tệp ngay khi chọn
            anhMoi = duLieu; xoaAnh = false;
        }
        catch (Exception ex) when (ex is IOException or ArgumentException or InvalidOperationException or TaskCanceledException)
        {
            loi = "Không đọc được ảnh. Chọn ảnh PNG, JPEG hoặc WebP không quá 3 MB.";
        }
        finally { dangTaiAnh = false; }
    }

    private async Task Luu()
    {
        if (dangBan || dangTaiAnh) return;
        dangBan = true; loi = null;
        Guid? ma = null;
        try
        {
            banNhap.Tags = tagsChon.ToList();
            banNhap.HieuLucDen = hieuLucNhap is { } d ? new DateTimeOffset(d.Date.AddDays(1).AddSeconds(-1), TimeSpan.FromHours(7)) : null;
            ma = await DichVu.LuuAsync(banNhap, anhMoi, xoaAnh);
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or ArgumentException) { loi = ex.Message; }
        catch { loi = "Không lưu được văn bản. Vui lòng thử lại."; }
        finally { dangBan = false; }
        // Đóng/báo về SAU khi đã thoát khỏi khối lưu: không còn đụng vào trạng thái của biểu mẫu nữa.
        if (ma is not null) await KetThuc(ma);
    }

    private Task Huy() => KetThuc(null);
    private async Task KetThuc(Guid? ma)
    {
        if (TrongHopThoai) HopThoai.Close(ma);
        else await KhiXong.InvokeAsync(ma);
    }
}
