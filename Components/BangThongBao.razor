@implements IDisposable
@inject DichVuThongBao DichVu
@inject KhoThongBaoDemo Kho
@inject AuthenticationStateProvider XacThuc
@inject Radzen.DialogService HopThoai

@* Bảng thông báo theo thể thức văn bản hành chính (bố cục kiểu cổng thông tin cơ quan, ý tưởng từ repo LTMT):
   chuyên mục theo loại văn bản, danh sách có ô ngày ban hành, mức độ, ghim, chấm chưa đọc; chi tiết có bảng thuộc tính văn bản.
   Mỗi người chỉ thấy thông báo gửi tới mình (lọc ở DichVuThongBao). *@
<section class="bang-thong-bao" aria-labelledby="tieu-de-bang-tin">
    <header class="dau-bang-tin">
        <div><h2 id="tieu-de-bang-tin">Văn bản, thông báo</h2><small class="phu-dong">@KetQua.Count văn bản · @SoChuaDoc chưa đọc</small></div>
        @if (laAdmin) { <RadzenButton Text="Đăng văn bản" Icon="add" Click="Them" Disabled="dangBan" /> }
    </header>
    <div class="tb-chuyen-muc" role="tablist" aria-label="Chuyên mục">
        <button type="button" role="tab" aria-selected="@(loaiLoc == "" ? "true" : "false")" class="@(loaiLoc == "" ? "dang-chon" : "")" @onclick="@(() => loaiLoc = "")">Tất cả <small>@danhSach.Count</small></button>
        @foreach (var loai in DichVuThongBao.CacLoaiVanBan.Where(l => danhSach.Any(x => x.LoaiVanBan == l)))
        {
            <button type="button" role="tab" aria-selected="@(loaiLoc == loai ? "true" : "false")" class="@(loaiLoc == loai ? "dang-chon" : "")" @onclick="() => loaiLoc = loai">@loai <small>@danhSach.Count(x => x.LoaiVanBan == loai)</small></button>
        }
    </div>
    <div class="bo-loc-tin">
        <div><label for="tim-thong-bao">Tìm văn bản</label><input id="tim-thong-bao" class="form-control" placeholder="Số/ký hiệu, tiêu đề, trích yếu, nội dung, tag…" @bind="tuKhoa" @bind:event="oninput" /></div>
        <div><label for="loc-tag-tin">Nơi nhận</label><select id="loc-tag-tin" class="form-select" @bind="tagLoc"><option value="">Tất cả</option><option value="chung">Toàn hệ thống (không gắn tag)</option><option value="lop:*">Lớp đào tạo…</option>@foreach (var tag in danhMucTags.Where(x => x.Ma.StartsWith("khoa:"))) { <option value="@tag.Ma">@tag.Ten</option> }</select></div>
        <label class="chon-khoa tb-chua-doc"><RadzenCheckBox TValue="bool" @bind-Value="chiChuaDoc" /> Chỉ văn bản chưa đọc</label>
    </div>
    @if (tagLoc == "lop:*") { <ChonPhamViLop Id="loc-lop-tin" @bind-Value="phamViLoc" /> }
    @if (banNhap is null && (!string.IsNullOrEmpty(loi) || !string.IsNullOrEmpty(thanhCong)))
    {
        <div class="phan-hoi-tin @(loi != "" ? "phan-hoi-loi" : "phan-hoi-thanh-cong")" role="@(loi != "" ? "alert" : "status")" tabindex="-1" @ref="khungPhanHoi">
            <strong>@(loi != "" ? "Không thực hiện được thao tác" : "Thành công")</strong>
            <p>@(loi != "" ? loi : thanhCong)</p>
        </div>
    }
    @if (banNhap is not null && laAdmin) { <BieuMauThongBao @key="banNhap" DuLieuBanDau="banNhap" KhiXong="XongSoanMoi" /> }

    @if (KetQua.Count == 0)
    {
        <div class="tin-trong">@(danhSach.Count == 0 ? "Chưa có văn bản nào gửi tới bạn." : "Không có văn bản phù hợp. Hãy đổi từ khóa hoặc bộ lọc.")</div>
    }
    else if (BaiDangXem is { } bai)
    {
        <div class="noi-dung-bang-tin">
            <aside class="cot-tieu-de" aria-label="Danh sách văn bản">
                <div class="nhan-danh-sach">@KetQua.Count văn bản · Ghim trước, mới nhất sau</div>
                <div class="danh-sach-tieu-de" tabindex="0" aria-label="Cuộn danh sách">
                    @foreach (var tin in KetQua)
                    {
                        var ngay = tin.DangLuc.ToOffset(TimeSpan.FromHours(7));
                        <button type="button" class="muc-tin tb-muc @(tin.Ma == bai.Ma ? "dang-chon" : "") @(daDoc.Contains(tin.Ma) ? "" : "chua-doc")" @onclick="() => Xem(tin)" aria-pressed="@(tin.Ma == bai.Ma)">
                            @if (tin.Anh is not null) { <img class="tb-anh-nho" src="@tin.Anh" alt="" loading="lazy" /> }
                            else { <span class="tb-o-ngay"><strong>@ngay.ToString("dd")</strong><small>Th@(ngay.Month)/@ngay.ToString("yy")</small></span> }
                            <span class="tb-chu-muc">
                                <span class="tb-dong-nhan">
                                    @if (tin.Ghim) { <RadzenIcon Icon="push_pin" class="tb-ghim" title="Đã ghim" /> }
                                    <span class="tb-loai">@tin.LoaiVanBan</span>
                                    @if (tin.SoKyHieu != "") { <span class="tb-so">@tin.SoKyHieu</span> }
                                    @if (tin.MucDo != "Thường") { <span class="tb-muc-do @LopMucDo(tin.MucDo)">@tin.MucDo</span> }
                                    @if (tin.LaMoi(hienTai)) { <span class="nhan-new">new</span> }
                                    @if (tin.HetHieuLuc(hienTai)) { <span class="tb-het-han">Hết hiệu lực</span> }
                                </span>
                                <strong>@tin.TieuDe</strong>
                                <small class="tb-ngay-nho">@ngay.ToString("HH:mm · dd/MM/yyyy")</small>
                                @if (tin.TrichYeu != "") { <small class="tb-trich-yeu">@tin.TrichYeu</small> }
                            </span>
                        </button>
                    }
                </div>
            </aside>
            <article class="chi-tiet-tin tb-chi-tiet" aria-live="polite">
                <div class="dau-chi-tiet">
                    <span class="nhan-tong-quan">@bai.LoaiVanBan.ToUpperInvariant()</span>
                    @if (bai.MucDo != "Thường") { <span class="tb-muc-do @LopMucDo(bai.MucDo)">@bai.MucDo</span> }
                    @if (bai.Ghim) { <span class="tb-loai"><RadzenIcon Icon="push_pin" />Ghim</span> }
                    @if (bai.LaMoi(hienTai)) { <span class="nhan-new">new</span> }
                    <button type="button" class="tb-nut-in" onclick="window.print()" title="In văn bản (bản sạch, ẩn menu)"><RadzenIcon Icon="print" />In</button>
                </div>
                <h2>@bai.TieuDe</h2>
                @if (bai.TrichYeu != "") { <p class="tb-trich-yeu-lon">@bai.TrichYeu</p> }
                <dl class="tb-thuoc-tinh">
                    <div><dt>Số / ký hiệu</dt><dd>@(bai.SoKyHieu == "" ? "—" : bai.SoKyHieu)</dd></div>
                    <div><dt>Ngày ban hành</dt><dd>@NgayGio(bai.DangLuc)</dd></div>
                    <div><dt>Cơ quan ban hành</dt><dd>@bai.CoQuanBanHanh</dd></div>
                    <div><dt>Người ký</dt><dd>@(bai.NguoiKy == "" ? "—" : bai.NguoiKy)</dd></div>
                    <div><dt>Hiệu lực hiển thị</dt><dd>@(bai.HieuLucDen is { } han ? "đến " + han.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy") : "Không thời hạn")</dd></div>
                    <div><dt>Người đăng</dt><dd>@bai.TacGia@(bai.SuaLuc is { } sua ? $" · sửa {NgayGio(sua)}" : "")</dd></div>
                    <div class="toan-hang"><dt>Nơi nhận</dt><dd><span class="tags-tin">@if (bai.Tags.Count == 0) { <span class="tag-tin">Toàn hệ thống</span> }@foreach (var tag in bai.Tags) { <span class="tag-tin">@TenTag(tag)</span> }</span></dd></div>
                </dl>
                @if (bai.Anh is not null) { <img class="anh-thong-bao" src="@bai.Anh" alt="Ảnh đính kèm: @bai.TieuDe" data-phong-to tabindex="0" title="Bấm để xem ảnh lớn" /> }
                <div class="van-ban-tin">@bai.NoiDung</div>
                @if (laAdmin)
                {
                    <div class="tb-da-doc">
                        <button type="button" class="nut-so-luong" @onclick="() => XemNguoiDoc(bai)"><RadzenIcon Icon="visibility" />Ai đã đọc</button>
                        @if (nguoiDoc is not null && maNguoiDoc == bai.Ma)
                        {
                            <span class="phu-dong">@nguoiDoc.Count người đã mở: @string.Join(", ", nguoiDoc.Take(12).Select(x => x.TenDangNhap))@(nguoiDoc.Count > 12 ? "…" : "")</span>
                        }
                    </div>
                    <div class="hanh-dong-tin"><RadzenButton Text="Sửa" Icon="edit" Click="() => Sua(bai)" ButtonStyle="ButtonStyle.Light" Disabled="dangBan" /><RadzenButton Text="Xóa" Icon="delete" Click="() => Xoa(bai)" ButtonStyle="ButtonStyle.Danger" Disabled="dangBan" /></div>
                }
            </article>
        </div>
    }
</section>

@code {
    [Parameter] public Guid? MaChon { get; set; }
    private List<ThongBao> danhSach = [];
    private List<TagThongBao> danhMucTags = [];
    private HashSet<Guid> daDoc = [];
    /// <summary>Bản nháp văn bản mới đang soạn ngay trên trang (sửa văn bản cũ thì mở hộp thoại riêng).</summary>
    private ThongBao? banNhap;
    private string phamViLoc = "lop:*";
    private List<LopDaoTao> cacLop = [];
    private Guid? maDangXem;
    private string tuKhoa = "", tagLoc = "", loaiLoc = "", loi = "", thanhCong = "";
    private bool chiChuaDoc;
    private bool laAdmin, dangBan, dangSua, daHuy;
    private DateTimeOffset hienTai = DateTimeOffset.UtcNow;
    private System.Threading.Timer? dongHo;
    private ElementReference khungPhanHoi;
    private bool canFocusPhanHoi;
    private List<ThongBaoDaDoc>? nguoiDoc;
    private Guid? maNguoiDoc;
    private int SoChuaDoc => danhSach.Count(x => !daDoc.Contains(x.Ma));
    private string TenTag(string ma) => danhMucTags.FirstOrDefault(x => x.Ma == ma)?.Ten ?? ma;
    private static string NgayGio(DateTimeOffset moc) => moc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm · dd/MM/yyyy");
    private static string LopMucDo(string mucDo) => mucDo == "Khẩn" ? "khan" : "quan-trong";
    private List<ThongBao> KetQua => danhSach.Where(x =>
        (loaiLoc == "" || x.LoaiVanBan == loaiLoc) && (!chiChuaDoc || !daDoc.Contains(x.Ma)) &&
        (tagLoc == "" || (tagLoc == "chung" ? x.Tags.Count == 0 : tagLoc == "lop:*" ? DichVuThongBao.KhopPhamVi(x.Tags, phamViLoc, cacLop) : x.Tags.Contains(tagLoc))) &&
        TimKiemMo.Khop(tuKhoa, x.TieuDe, x.SoKyHieu, x.TrichYeu, x.NoiDung, x.TacGia, x.NguoiKy, string.Join(" ", x.Tags.Select(TenTag)))).ToList();
    private ThongBao? BaiDangXem => KetQua.FirstOrDefault(x => x.Ma == maDangXem) ?? KetQua.FirstOrDefault();
    protected override async Task OnInitializedAsync()
    {
        laAdmin = (await XacThuc.GetAuthenticationStateAsync()).User.IsInRole("Admin");
        maDangXem = MaChon;
        await TaiLai();
        Kho.DaThayDoi += KhiThayDoi;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) dongHo = new System.Threading.Timer(_ => KhiThayDoi(), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        // Mở chi tiết = đã đọc (chỉ ghi một lần cho mỗi người, mỗi văn bản).
        if (BaiDangXem is { } bai && !daDoc.Contains(bai.Ma))
        {
            daDoc.Add(bai.Ma);
            await DichVu.DanhDauDaDocAsync(bai.Ma);
            StateHasChanged();
        }
        if (canFocusPhanHoi)
        {
            canFocusPhanHoi = false;
            if (banNhap is null) try { await khungPhanHoi.FocusAsync(); } catch (InvalidOperationException) { }
        }
    }
    private async Task TaiLai()
    {
        danhSach = await DichVu.LayDanhSachChoToiAsync();
        daDoc = await DichVu.LayDaDocAsync();
        danhMucTags = DichVu.LayTags(); cacLop = DichVu.LayLop(); hienTai = DateTimeOffset.UtcNow;
    }
    private void KhiThayDoi() { if (!daHuy) _ = InvokeAsync(async () => { if (!daHuy) { await TaiLai(); StateHasChanged(); } }); }
    private void Xem(ThongBao tin) { maDangXem = tin.Ma; nguoiDoc = null; }
    private async Task XemNguoiDoc(ThongBao bai)
    {
        try { nguoiDoc = await DichVu.LayNguoiDaDocAsync(bai.Ma); maNguoiDoc = bai.Ma; }
        catch (UnauthorizedAccessException ex) { loi = ex.Message; }
    }
    private void Them()
    {
        banNhap = new() { SoKyHieu = DichVu.GoiYSoKyHieu("Thông báo") };
        loi = thanhCong = "";
    }
    private async Task XongSoanMoi(Guid? ma)
    {
        banNhap = null;
        if (ma is not null) await DaLuu(ma.Value, "Đã đăng văn bản. Văn bản vừa đăng đang được hiển thị bên dưới.");
    }
    private async Task Sua(ThongBao bai)
    {
        if (dangSua) return;
        dangSua = true; loi = thanhCong = "";
        try
        {
            var kq = await HopThoai.OpenAsync<BieuMauThongBao>("Sửa văn bản",
                new() { [nameof(BieuMauThongBao.DuLieuBanDau)] = bai, [nameof(BieuMauThongBao.TrongHopThoai)] = true },
                new DialogOptions { Width = "960px", Height = "85vh", ShowClose = true, CloseDialogOnOverlayClick = false, CloseDialogOnEsc = true, CssClass = "hop-sua-van-ban" });
            if (kq is Guid ma) await DaLuu(ma, "Đã lưu thay đổi của văn bản.");
        }
        finally { dangSua = false; }
    }
    private async Task DaLuu(Guid ma, string thongDiep)
    {
        maDangXem = ma; tuKhoa = tagLoc = loaiLoc = "";
        await TaiLai();
        thanhCong = thongDiep; canFocusPhanHoi = true;
        StateHasChanged();
    }
    private async Task Xoa(ThongBao bai)
    {
        if (await HopThoai.Confirm($"Bạn sắp xóa văn bản “{bai.TieuDe}”. Thao tác không thể hoàn tác.", "Xác nhận xóa", new ConfirmOptions { OkButtonText = "Xóa", CancelButtonText = "Hủy", CssClass = "hop-xac-nhan-xoa" }) != true) return;
        dangBan = true; loi = thanhCong = "";
        try { await DichVu.XoaAsync(bai.Ma); await TaiLai(); thanhCong = "Đã xóa văn bản."; }
        catch (Exception ex) when (ex is UnauthorizedAccessException or ArgumentException) { loi = ex.Message; }
        catch { loi = "Không xóa được văn bản. Vui lòng thử lại."; }
        finally { dangBan = false; canFocusPhanHoi = true; }
    }
    public void Dispose() { daHuy = true; Kho.DaThayDoi -= KhiThayDoi; dongHo?.Dispose(); }
}
